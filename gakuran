local function diff_new(prev_set, cur_dict)
    local fresh = {}
    for assetId, tpos in pairs(cur_dict) do
        local previous = prev_set[assetId]
        if previous == nil or (type(previous) == "number" and tpos < previous - 0.02) then
            fresh[#fresh + 1] = assetId
        end
    end
    return fresh
end

local function snapshot_ids(dict)
    local set = {}
    for assetId, tpos in pairs(dict) do set[assetId] = tpos end
    return set
end

S.OutcomeState.find_latest = function(now, max_age)
    for i = #S.OutcomeState.pending, 1, -1 do
        local action = S.OutcomeState.pending[i]
        local age = now - action.at
        if age >= 0 and age <= max_age then return action, i end
    end
    return nil, nil
end

S.OutcomeState.record = function(action, outcome, reason, extra)
    if not action then return end
    local key = action.style .. " " .. action.move
    local stats = S.ParryStats[key] or { hit = 0, miss = 0, unknown = 0 }
    S.ParryStats[key] = stats

    if outcome == "ok" then stats.hit = stats.hit + 1
    elseif outcome == "miss" then stats.miss = stats.miss + 1
    else stats.unknown = stats.unknown + 1 end

    local decided = stats.hit + stats.miss
    local pct = decided > 0 and (stats.hit / decided) * 100 or 0
    local label = string.format(
        "%s %s (end=%dms start=%.0fms window=%dms t=%.3f ping=%.0fms age=%.0fms)",
        action.style, action.move, action.parryEnd,
        action.effectiveStart or action.parryEnd,
        action.parryWindow or 0, action.tpos or 0,
        action.ping or 0, action.resultAge or 0
    )

    if outcome == "ok" then
        log.add(string.format("PARRY OK   %s  [%d/%d %.0f%%]", label, stats.hit, decided, pct), Colors.GREEN)
    elseif outcome == "miss" then
        local detail = extra and string.format(" damage=%.2f", extra) or ""
        log.add(string.format("PARRY MISS %s reason=%s%s  [%d/%d %.0f%%]", label, tostring(reason or "unknown"), detail, stats.hit, decided, pct), Colors.RED)
    elseif UI.debug_on:get_value() then
        log.add(string.format("PARRY NO RESULT %s  [unresolved=%d]", label, stats.unknown), Colors.YELLOW)
    end

    -- ================= SMART OFFSET DATA COLLECTION =================
    if UI.smart_offset_on:get_value() and (outcome == "ok" or outcome == "miss") then
        local sample = { outcome = outcome, reason = reason, tpos = action.tpos, early = false, style = action.style, move = action.move }
        
        if outcome == "miss" then
            if reason == "fail_animation" then
                sample.early = true
            elseif reason == "health_loss" then
                if action.at < action.blockStart then 
                    sample.early = true 
                    sample.miss_distance = math.floor(extra or 0) + 5 
                else 
                    sample.early = false 
                    sample.miss_distance = math.floor(extra or 0) + 5
                end
            end
        elseif outcome == "ok" then
            -- Only nudge if it was pressed heavily on one side of the window
            local age_ratio = (action.resultAge or 0) / (action.parryWindow or 130)
            if age_ratio < 0.3 then
                sample.early = true
                sample.miss_distance = 1 
            elseif age_ratio > 0.7 then
                sample.early = false
                sample.miss_distance = 1
            else
                return -- Perfectly centered, don't nudge!
            end
        end
        
        S.SmartOffset.samples[#S.SmartOffset.samples + 1] = sample
        if #S.SmartOffset.samples > 60 then table.remove(S.SmartOffset.samples, 1) end
        UI.smart_offset_status:set_label(string.format("Smart Offset: %d/60 samples", #S.SmartOffset.samples))
    end
end

S.OutcomeState.resolve_latest = function(outcome, reason, now, max_age, extra)
    local action, index = S.OutcomeState.find_latest(now, max_age)
    if not action then return false end
    table.remove(S.OutcomeState.pending, index)
    action.resultAge = now - action.at
    S.OutcomeState.record(action, outcome, reason, extra)
    return true
end

S.OutcomeState.expire = function(now)
    for i = #S.OutcomeState.pending, 1, -1 do
        local action = S.OutcomeState.pending[i]
        if now - action.at > 1100 then
            table.remove(S.OutcomeState.pending, i)
            action.resultAge = now - action.at
            S.OutcomeState.record(action, "unknown", "timeout")
        end
    end
end

S.OutcomeState.health_frame = function(now)
    local lp = get_local_player()
    local char = valid(lp) and lp.character or nil
    local hum = valid(char) and char:find_first_child_class("Humanoid") or nil
    if not valid(hum) then
        S.OutcomeState.humanoidId = nil
        S.OutcomeState.health = nil
        return
    end

    local ok, health = pcall(function() return hum.health end)
    if not ok or type(health) ~= "number" then return end

    local identity = tostring(hum.identity)
    if S.OutcomeState.humanoidId ~= identity or S.OutcomeState.health == nil or health > S.OutcomeState.health then
        if S.OutcomeState.humanoidId ~= identity then S.OutcomeState.pending = {} end
        S.OutcomeState.humanoidId = identity
        S.OutcomeState.health = health
        return
    end

    local damage = S.OutcomeState.health - health
    S.OutcomeState.health = health
    if damage > 0.01 then
        S.OutcomeState.resolve_latest("miss", "health_loss", now, 800, damage)
    end
end

local function check_local_signals()
    local lp = get_local_player()
    local char = valid(lp) and lp.character or nil
    local hum = valid(char) and char:find_first_child_class("Humanoid") or nil
    local animator = get_animator(char)
    if not valid(hum) or not valid(animator) then return end

    local now = get_tickcount()
    local anims = read_active_animations(animator)
    local humanoid_id = tostring(hum.identity)
    if S.OutcomeState.signalHumanoidId ~= humanoid_id then
        S.OutcomeState.signalHumanoidId = humanoid_id
        S.LocalSeenSuccess = snapshot_ids(anims)
        S.LocalSeenStun = snapshot_ids(anims)
        S.LocalSeenFail = snapshot_ids(anims)
        S.LocalSeenCounter = snapshot_ids(anims)
        return
    end

    for _, assetId in ipairs(diff_new(S.LocalSeenSuccess, anims)) do
        if Anims.Parried[assetId] then
            if S.OutcomeState.resolve_latest("ok", "perfect_block_anim", now, 650) then
                block_end()
                S.LastPressAt = -999999
            end
        end
    end
    for _, assetId in ipairs(diff_new(S.LocalSeenStun, anims)) do
        if Anims.Stunned[assetId] then
            block_end()
            S.LastPressAt = now
        end
    end
    for _, assetId in ipairs(diff_new(S.LocalSeenFail, anims)) do
        if Anims.Failed[assetId] then
            S.OutcomeState.resolve_latest("miss", "fail_animation", now, 800)
        end
    end

    for _, assetId in ipairs(diff_new(S.LocalSeenCounter, anims)) do
        if assetId == "rbxassetid://82196924299426" then
            S.LastCounterAt = now
            if UI.debug_on:get_value() then
                log.add("[WingChun] M2 Animation detected! 8s cooldown started.", Colors.CYAN)
            end
        end
    end

    S.OutcomeState.expire(now)
    S.LocalSeenSuccess = snapshot_ids(anims)
    S.LocalSeenStun = snapshot_ids(anims)
    S.LocalSeenFail = snapshot_ids(anims)
    S.LocalSeenCounter = snapshot_ids(anims)
end

-- ================= parry ESP =================
local RING_SEGMENTS = 40
local FEET_OFFSET = 3

local function get_camera()
    local ws = game:get_service("Workspace")
    return valid(ws) and ws:find_first_child_class("Camera") or nil
end

local function in_front_of_camera(cam, world_pos)
    if not valid(cam) then return false end
    local cam_pos = cam.camera_position
    local look = cam.camera_lookvector
    local dx = world_pos.x - cam_pos.x
    local dy = world_pos.y - cam_pos.y
    local dz = world_pos.z - cam_pos.z
    return (dx * look.x) + (dy * look.y) + (dz * look.z) > 0
end

local function draw_range_ring(cam, cx, cy, cz, radius, ring_color)
    local points = {}
    for i = 0, RING_SEGMENTS do
        local ang = (i / RING_SEGMENTS) * math.pi * 2
        local wp = vector3(cx + math.cos(ang) * radius, cy, cz + math.sin(ang) * radius)
        local ok = in_front_of_camera(cam, wp)
        local sp = nil
        if ok then
            local s_ok, res = pcall(world_to_screen, wp)
            if s_ok and res then 
                sp = res
                ok = not sp:out_of_screen(sp)
            else ok = false end
        end
        if ok then
            points[#points + 1] = sp
        elseif #points >= 2 then
            render.add_polyline(points, ring_color, 8)
            points = {}
        else
            points = {}
        end
    end
    if #points >= 2 then render.add_polyline(points, ring_color, 8) end
end

local function draw_cone_line(cam, cx, cy, cz, fx, fz, ang, radius)
    local ca = math.cos(ang)
    local sa = math.sin(ang)
    local rx = fx * ca - fz * sa
    local rz = fx * sa + fz * ca
    local a_wp = vector3(cx, cy, cz)
    local b_wp = vector3(cx + rx * radius, cy, cz + rz * radius)
    if not in_front_of_camera(cam, a_wp) or not in_front_of_camera(cam, b_wp) then return end
    local a_ok, a = pcall(world_to_screen, a_wp)
    local b_ok, b = pcall(world_to_screen, b_wp)
    if a_ok and a and b_ok and b and not a:out_of_screen(a) and not b:out_of_screen(b) then
        render.add_line(a, b, Colors.CONE, 8)
    end
end

local function draw_box(cam, root, col, thick)
    local p = root.position
    local top_wp = vector3(p.x, p.y + 3, p.z)
    local bot_wp = vector3(p.x, p.y - 3, p.z)
    if not in_front_of_camera(cam, top_wp) or not in_front_of_camera(cam, bot_wp) then return end
    local top_ok, top = pcall(world_to_screen, top_wp)
    local bot_ok, bot = pcall(world_to_screen, bot_wp)
    if not top_ok or not top or not bot_ok or not bot then return end
    if top:out_of_screen(top) or bot:out_of_screen(bot) then return end
    local y1, y2 = top.y, bot.y
    if y1 > y2 then y1, y2 = y2, y1 end
    local h = y2 - y1
    if h < 8 then return end
    local w = math.max(20, h * 0.45)
    local x = (top.x + bot.x) / 2
    render.add_rect(vector2(x - w / 2, y1), vector2(x + w / 2, y2), col, 0, thick or 2)
end

local function draw_target_label(cam, target, col)
    local p = target.root.position
    local wp = vector3(p.x, p.y + 3.35, p.z)
    if not in_front_of_camera(cam, wp) then return end
    local sp_ok, sp = pcall(world_to_screen, wp)
    if not sp_ok or not sp or sp:out_of_screen(sp) then return end

    local health = target.health or 0
    local max_health = target.maxHealth or 100
    local health_ratio = clamp(health / max_health, 0, 1)
    local style = target.style or "Unknown"
    local name = tostring(target.player.name or "?")
    
    render.add_text(vector2(sp.x - (#style * 21) / 2, sp.y - 58), style, Colors.WHITE, 42, true)
    render.add_text(vector2(sp.x - (#name * 7) / 2, sp.y - 15), name, col, 14, true)

    local bar_width, bar_height = 130, 9
    local bar_left, bar_top = sp.x - bar_width / 2, sp.y + 3
    local bar_color = color(1 - health_ratio, health_ratio, 0.12, 1)
    render.add_rect_filled(vector2(bar_left, bar_top), vector2(bar_left + bar_width, bar_top + bar_height), color(0.03, 0.03, 0.03, 0.9), 0)
    render.add_rect_filled(vector2(bar_left + 2, bar_top + 2), vector2(bar_left + 2 + ((bar_width - 4) * health_ratio), bar_top + bar_height - 2), bar_color, 0)
    render.add_rect(vector2(bar_left, bar_top), vector2(bar_left + bar_width, bar_top + bar_height), Colors.WHITE, 0, 2)

    local hp_text = string.format("%.0f / %.0f HP", health, max_health)
    render.add_text(vector2(sp.x - (#hp_text * 6) / 2, bar_top + 11), hp_text, Colors.WHITE, 12, true)
end

local function draw_parry_esp()
    local my_root = get_my_root()
    if not valid(my_root) then return end
    local cam = get_camera()
    local p = my_root.position
    local radius = UI.range_s:get_value()
    local cy = p.y - FEET_OFFSET

    if UI.show_esp:get_value() then
        draw_range_ring(cam, p.x, cy, p.z, radius, Colors.RING)
        if UI.facing_me:get_value() then
            local deg = UI.cone_s:get_value()
            if deg < 360 then
                local fx, fz = flat_look(my_root)
                local half = (deg / 2) * (math.pi / 180)
                draw_cone_line(cam, p.x, cy, p.z, fx, fz, half, radius)
                draw_cone_line(cam, p.x, cy, p.z, fx, fz, -half, radius)
            end
        end
    end

    if (UI.dodge_m2:get_value() or UI.dodge_m1:get_value()) and UI.show_dodge_esp:get_value() then
        draw_range_ring(cam, p.x, cy, p.z, UI.dodge_range_s:get_value(), Colors.DODGE_RING)
    end

    if not UI.mark_rng:get_value() then return end
    for index, target in ipairs(S.EspTargets) do
        local ok_angle = check_direction(false, my_root, target.root)
        if not UI.mark_gate:get_value() or ok_angle then
            local target_color = index == 1 and Colors.RANGE or Colors.OTHER_TARGET
            draw_box(cam, target.root, target_color, ok_angle and 8 or 4)
            draw_target_label(cam, target, target_color)
        end
    end
end

