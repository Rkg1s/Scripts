local function settings_save()
    local t = {}
    for _, e in ipairs(Settings.Items) do
        local val = nil
        pcall(function() val = e.w:get_value() end)
        if val ~= nil then
            if type(val) == "boolean" then val = val and 1 or 0 end
            t[e.key] = val
        end
    end
    
    local ok, err = pcall(function()
        file.overwrite(Settings.File, table_to_JSON(t))
    end)
    if not ok and UI.debug_on:get_value() then
        log.add("[settings] save failed: " .. tostring(err), Colors.RED)
    end
    return ok
end

local function settings_load()
    if not file.exists(Settings.File) then return false end
    local ok, data = pcall(function() return JSON_to_table(file.read(Settings.File)) end)
    if not ok or type(data) ~= "table" then return false end

    is_loading = true 
    for _, e in ipairs(Settings.Items) do
        local v = data[e.key]
        if type(v) == "number" then 
            if e.def == true or e.def == false then
                set_ui_value(e.label, v ~= 0) 
            else
                set_ui_value(e.label, v) 
            end
        end
    end
    is_loading = false 
    
    load_smart_offsets_from_json()
    
    return true
end

local function setup_callbacks()
    for _, e in ipairs(Settings.Items) do
        if e.w and e.w.change_callback then
            e.w:change_callback(function()
                if not is_loading then
                    settings_save()
                end
            end)
        end
    end
end

