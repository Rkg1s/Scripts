local function evaluate_attacker(plr, char, my_root)
    local root = char:find_first_child("HumanoidRootPart")
    local animator = get_animator(char)
    if not valid(root) or not valid(animator) then return end

    local dist2 = flat_dist2(root.position, my_root.position)
    if dist2 > (UI.range_s:get_value() * UI.range_s:get_value()) then return end
    if math.abs(root.position.y - my_root.position.y) > UI.vert_s:get_value() then return end

    get_height(char)
    local anims = read_active_animations(animator)
    local seen_this_tick = {}
    local now = get_tickcount()

    for assetId, tpos in pairs(anims) do
        local cfg = GameConfig[assetId]
        if cfg then
            local clean_style = string.gsub(cfg.Style, "Anims$", "")
            S.TargetStyleCache[tostring(plr.identity)] = clean_style
            
            seen_this_tick[assetId] = true
            local key = tostring(plr.identity) .. "|" .. assetId
            local reg = S.AnimRegistry[key]
            local is_heavy = is_heavy_move(cfg.DisplayName)
            local in_range = math.sqrt(dist2) <= UI.dodge_range_s:get_value()
            local should_dodge = in_range and ((is_heavy and UI.dodge_m2:get_value()) or (not is_heavy and UI.dodge_m1:get_value()))

            if not reg then
                reg = make_attack_registry(now, tpos, char, my_root, cfg, should_dodge)
                S.AnimRegistry[key] = reg
            end

            if tpos < reg.trackTime - 0.02 then
                reg = make_attack_registry(now, tpos, char, my_root, cfg, should_dodge)
                S.AnimRegistry[key] = reg
            end
            reg.trackTime = tpos

            if not reg.processed then
                if cfg.ParryFunction then
                    cfg.ParryFunction({ reg = reg, char = char, style = cfg.Style, move = cfg.DisplayName })
                elseif check_direction(is_heavy, my_root, root) then
                    if now >= reg.blockStart and now <= reg.blockExpire then
                        if reg.shouldDodge then
                            reg.processed = true
                            do_dodge()
                            if cfg.PostDodgeBlockDelay then
                                S.DelayedBlocks[#S.DelayedBlocks + 1] = { at = now + cfg.PostDodgeBlockDelay, hold = cfg.PostDodgeBlockHold or Const.BlockHoldMs }
                            end
                        else
                            local use_counter = false
                            if UI.wingchun_counter:get_value() and UI.wingchun_keybind:get_state() then
                                if now - (S.LastCounterAt or -99999) >= 8000 and not is_local_busy_attacking() then
                                    use_counter = true
                                end
                            end

                            if use_counter then
                                input.simulate_press(0x52) 
                                S.LastCounterAt = now      
                                reg.processed = true
                                log.add("[WingChun] Attempting M2 Counter... (R)", Colors.YELLOW)
                            elseif block_start(now, reg.holdMs, cfg.Style == "StrikerAnims") then
                                reg.processed = true
                                local move_name = reg.stage == 2 and "M2 Downcut" or cfg.DisplayName
                                S.OutcomeState.push({
                                    style = cfg.Style, move = move_name, at = now, parryEnd = reg.parryEnd, parryWindow = reg.parryWindow,
                                    attacker = tostring(plr.name or "?"), attackerId = tostring(plr.identity), assetId = assetId, stage = reg.stage, tpos = tpos,
                                    ping = S.TimingState.ping, heightAdjustment = reg.heightAdjustment or 0, pingAdjustment = reg.pingAdjustment or 0,
                                    effectiveStart = reg.effectiveStart, blockStart = reg.blockStart, blockExpire = reg.blockExpire,
                                })

                                if reg.stage == 1 and cfg.SecondParryTimeMs then
                                    local second_adjust = height_adjust_ms(char, my_root, cfg.SecondParryTimeMs, cfg.Style, true)
                                    local second_ping = S.TimingState.compensation()
                                    local second_window = cfg.SecondParryWindowMs or UI.window_s:get_value()
                                    local second_end = cfg.SecondParryTimeMs + second_adjust + UI.offset_s:get_value()
                                    reg.stage = 2
                                    reg.processed = false
                                    reg.parryEnd = cfg.SecondParryTimeMs
                                    reg.parryWindow = second_window
                                    reg.holdMs = cfg.SecondHoldMs or Const.BlockHoldMs
                                    reg.heightAdjustment = second_adjust
                                    reg.pingAdjustment = second_ping
                                    reg.effectiveStart = second_end - second_window - second_ping
                                    reg.blockStart = reg.startTime + reg.effectiveStart
                                    reg.blockExpire = reg.startTime + second_end
                                end
                            end
                        end
                    elseif now > reg.blockExpire then
                        reg.processed = true
                    end
                end
            end
        elseif UI.log_unknown:get_value() and not Anims.Ignore[assetId] and not S.LoggedUnknown[assetId] then
            S.LoggedUnknown[assetId] = true
            log.add("[unknown] " .. assetId .. " (" .. tostring(plr.name) .. ")", Colors.CYAN)
        end
    end

    for key, _ in pairs(S.AnimRegistry) do
        local prefix = tostring(plr.identity) .. "|"
        if string.sub(key, 1, #prefix) == prefix then
            local assetId = string.sub(key, #prefix + 1)
            if not seen_this_tick[assetId] then S.AnimRegistry[key] = nil end
        end
    end
end

local function prioritized_targets(my_root)
    local targets = {}
    local lp = get_local_player()
    if not valid(lp) or not valid(my_root) then return targets end
    local radius = UI.range_s:get_value()
    local max_dist2 = radius * radius
    for _, plr in pairs(get_players()) do
        if valid(plr) and plr.identity ~= lp.identity then
            local char = plr.character
            local root = valid(char) and char:find_first_child("HumanoidRootPart") or nil
            local hum = valid(char) and char:find_first_child_class("Humanoid") or nil
            if valid(root) and valid(hum) and hum.health > 0 then
                local dist2 = flat_dist2(root.position, my_root.position)
                if dist2 <= max_dist2 and math.abs(root.position.y - my_root.position.y) <= UI.vert_s:get_value() then
                    targets[#targets + 1] = { player = plr, character = char, root = root, humanoid = hum, dist2 = dist2 }
                end
            end
        end
    end
    table.sort(targets, function(a, b) return a.dist2 < b.dist2 end)
    return targets
end

local function refresh_esp_targets(now, my_root)
    if now - S.EspTargetsAt < 25 then return end
    S.EspTargetsAt = now
    S.EspTargets = prioritized_targets(my_root)
    for _, target in ipairs(S.EspTargets) do
        local plr_id = tostring(target.player.identity)
        local style_name = S.TargetStyleCache[plr_id]
        
        if not style_name or style_name == "Unknown" then
            style_name = get_target_style(target)
            if style_name and style_name ~= "Unknown" then
                S.TargetStyleCache[plr_id] = style_name
            end
        end
        
        if not style_name or style_name == "Unknown" then
            local animator = get_animator(target.character)
            if valid(animator) then
                local ok, anims = pcall(read_active_animations, animator)
                if ok and type(anims) == "table" then
                    for assetId, tpos in pairs(anims) do
                        local cfg = GameConfig[assetId]
                        if cfg then
                            style_name = string.gsub(cfg.Style, "Anims$", "")
                            S.TargetStyleCache[plr_id] = style_name
                            break
                        end
                    end
                end
            end
        end
        
        target.style = style_name or "Unknown"
        target.health = math.max(0, target.humanoid.health or 0)
        target.maxHealth = math.max(1, target.humanoid.max_health or 100)
    end
end

local function scan_attackers()
    local my_root = get_my_root()
    if not valid(my_root) then return end
    for _, target in ipairs(S.EspTargets) do
        evaluate_attacker(target.player, target.character, my_root)
    end
end

