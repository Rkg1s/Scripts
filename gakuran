-- Function to save the Smart Offset Math to an external JSON file
local function save_smart_offsets_to_json()
    local t = {}
    for k, v in pairs(S.SmartOffset.move_offsets) do
        local base_time = 0
        local style_name = "Unknown"
        local move_name = "Unknown"
        
        local match_style, match_move = string.match(k, "^([^_]+)Anims_(.+)$")
        if match_style and match_move then
            style_name = match_style
            move_name = match_move
        end

        for s_name, moves in pairs(RawConfig) do
            if s_name == style_name .. "Anims" or s_name == style_name then
                for _, data in pairs(moves) do
                    if data.DisplayName == move_name then
                        base_time = data.ParryTimeMs or 0
                        break
                    end
                end
            end
        end
        
        local sign = "+"
        local offset_abs = v
        if v < 0 then
            sign = "-"
            offset_abs = math.abs(v)
        end
        
        local total = base_time + v
        
        t[style_name .. "_" .. move_name] = {
            BaseTime = base_time,
            Offset = string.format("%s %d", sign, offset_abs),
            TotalTime = total
        }
    end
    
    pcall(function()
        file.overwrite("SmartStyleOffset.json", table_to_JSON(t))
    end)
end

-- Function to load the Smart Offset Math from the external JSON file on startup
local function load_smart_offsets_from_json()
    if not file.exists("SmartStyleOffset.json") then return end
    local ok, data = pcall(function() return JSON_to_table(file.read("SmartStyleOffset.json")) end)
    if not ok or type(data) ~= "table" then return end
    
    for k, v in pairs(data) do
        if type(v) == "table" then
            local base = tonumber(v.BaseTime or 0)
            local sign, offset_str = string.match(v.Offset or "+ 0", "([%+%-])%s*(%d+)")
            local offset_val = tonumber(offset_str) or 0
            
            if sign == "-" then
                offset_val = -offset_val
            end
            
            local style, move = string.match(k, "^([^_]+)_(.+)$")
            if style and move then
                local internal_key = style .. "Anims_" .. move
                S.SmartOffset.move_offsets[internal_key] = offset_val
            end
        end
    end
end

function update_smart_offset(now)
    if not UI.smart_offset_on:get_value() then return end
    if now - S.SmartOffset.last_adjust < 3000 then return end -- Increased cooldown to 3s to reduce log spam
    
    local mode_idx = UI.smart_offset_mode:get_value()
    local mode = LEARNING_MODES[mode_idx] or LEARNING_MODES[0]
    
    local samples = S.SmartOffset.samples
    if #samples < 5 then return end 

    local total_early = 0
    local total_late = 0
    local found_signal = false
    local last_miss_style = "Unknown"
    local last_miss_move = "Unknown"
    local miss_amount = mode.base_nudge 

    for _, tf in ipairs(TIMEFRAMES) do
        if #samples >= tf then
            local hits, misses = 0, 0
            local early_misses, late_misses = 0, 0
            
            for i = #samples - tf + 1, #samples do
                local s = samples[i]
                if s.outcome == "ok" or s.outcome == "miss" then
                    if s.outcome == "miss" then misses = misses + 1 else hits = hits + 1 end
                    last_miss_style = s.style or "Unknown"
                    last_miss_move = s.move or "Unknown"
                    if s.early then 
                        early_misses = early_misses + 1
                        if s.miss_distance then miss_amount = math.max(miss_amount, s.miss_distance) end
                    else 
                        late_misses = late_misses + 1
                        if s.miss_distance then miss_amount = math.max(miss_amount, s.miss_distance) end
                    end
                end
            end
            
            if (hits + misses) > 0 and (misses / (hits + misses)) > mode.threshold then
                found_signal = true
                local weight = (tf == 5 and 3) or (tf == 15 and 2) or (tf == 30 and 1.5) or 1
                total_early = total_early + (early_misses * weight)
                total_late = total_late + (late_misses * weight)
            end
        end
    end

    if found_signal and (total_early > 0 or total_late > 0) then
        local move_key = last_miss_style .. "_" .. last_miss_move
        local current_offset = S.SmartOffset.move_offsets[move_key] or 0
        
        local step_size = miss_amount
        local history = S.SmartOffset.move_history[move_key] or { hits = 0, last_dir = 0 }
        
        local direction = (total_early > total_late) and 1 or -1
        if history.last_dir ~= 0 and direction ~= history.last_dir then
            step_size = math.max(1, math.floor(step_size / 2))
        end

        local new_offset = current_offset + (direction * step_size)
        
        if direction == 1 then
            log.add(string.format("[smart_offset] %s: %s %s was too early. Nudging internal offset +%dms -> %dms", mode.name, last_miss_style, last_miss_move, step_size, new_offset), Colors.YELLOW)
        else
            log.add(string.format("[smart_offset] %s: %s %s was too late. Nudging internal offset -%dms -> %dms", mode.name, last_miss_style, last_miss_move, step_size, new_offset), Colors.YELLOW)
        end

        if new_offset ~= current_offset then
            S.SmartOffset.move_offsets[move_key] = new_offset
            S.SmartOffset.tuning_state[move_key] = step_size
            S.SmartOffset.move_history[move_key] = { hits = 0, last_dir = direction }
            S.SmartOffset.last_adjust = now
            S.SmartOffset.samples = {}
            UI.smart_offset_status:set_label(string.format("Smart Offset: Tuning %s... (Step: %dms)", last_miss_move, step_size))
            
            save_smart_offsets_to_json()
        end
    end
end

