                                        draw_chamfered_outline(card_pos, card_size, 6, border_c, is_current and 2 or 1)
                                        if is_current then draw_corner_brackets(card_pos, card_size, accent, 6, 1, 2) end

                                        local chip_colors = { resolve_color(theme.Main), resolve_color(theme.Accent), resolve_color(theme.Accent2 or theme.Accent) }
                                        for i = 1, 3 do
                                            local cx = card_pos.x + 16 + (i - 1) * 18
                                            local cy = card_pos.y + 18
                                            draw_hex_filled(vector2(cx, cy), 8, chip_colors[i], 0)
                                            draw_hex_outline(vector2(cx, cy), 8, Library.Black, 1, 0)
                                        end

                                        local label = get_clipped_text(name, element.CardW - 12)
                                        render.add_text(card_pos:add(vector2(6, 32)), label, is_current and accent or Library.FontColor)
