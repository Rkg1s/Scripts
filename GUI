                                    local border_c = element.Picking and lerp_color(accent, Library.FontColor, pulse * 0.3) or Library.OutlineColor
                                    draw_chamfered_filled(k_pos, k_size, 6, Library.MainColor)
                                    draw_chamfered_outline(k_pos, k_size, 6, border_c, element.Picking and 2 or 1)
                                    if element.Picking then draw_corner_brackets(k_pos, k_size, accent, 6, 1, 2) end
                                    local text = element.Picking and "..." or ("[" .. element.Value .. "]")
                                    local t_size = render.get_text_size(text)
                                    render.add_text(k_pos:add(vector2(k_size.x/2 - t_size.x/2, k_size.y/2 - t_size.y/2)), text, Library.FontColor)
                                    if not Library.DraggingWindow and is_mouse_in_rect(k_pos, k_size) and can_interact then
                                        if mouse_pressed then
                                            element.Picking = true; Library.ActiveKeyPicker = { obj = element, layout = element.layout }
                                        elseif r_mouse_pressed then
                                            Library.OpenedKeybindMenu = { obj = element, pos = mouse_pos, size = vector2(64, 52) }
                                        end
                                    end

                                elseif element.Type == "ColorPicker" then
                                    render.add_text(element_pos, element.Text, Library.FontColor)
                                    local c_pos, c_size = element_pos:add(vector2(0, 17)), vector2(group_size.x - 16, 22)
                                    element.layout = { pos = c_pos, size = c_size }
                                    if element.EnableAlpha then draw_checkerboard(c_pos:add(vector2(2, 2)), c_size:subtract(vector2(4, 4)), 5) end
                                    render.add_rect_filled(c_pos:add(vector2(2, 2)), c_pos:add(c_size):subtract(vector2(2, 2)), element.Value, 3)
                                    draw_chamfered_outline(c_pos, c_size, 6, element.Open and accent or Library.OutlineColor, element.Open and 2 or 1)
                                    if element.Open then draw_corner_brackets(c_pos, c_size, accent, 6, 1, 2) end
                                    if not Library.DraggingWindow and mouse_pressed and is_mouse_in_rect(c_pos, c_size) and can_interact then
                                        element.Open = not element.Open
                                        Library.ActiveColorPicker = element.Open and { obj = element, layout = element.layout } or nil
                                    end

                                elseif element.Type == "Divider" then
                                    local div_y = element_pos.y + element.Height/2
                                    render.add_line(vector2(element_pos.x, div_y), vector2(element_pos.x + group_size.x - 16, div_y), Library.OutlineColor, 1)
                                    draw_hex_filled(vector2(element_pos.x + (group_size.x - 16)/2, div_y), 3, accent, 0)

                                elseif element.Type == "Label" then
