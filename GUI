                                    end
                                end

                                element_y = element_y + element.Height
                            end

                            if groupbox.Side == "Left" then left_y = left_y + group_size.y + 10 else right_y = right_y + group_size.y + 10 end
                        end
                    end
                end

                -- animated scan sweep across the content area
                local sweep_y = body_pos.y + ((get_unixtime() * 40) % body_size.y)
                render.add_line(vector2(body_pos.x + RAIL_W, sweep_y), vector2(body_pos.x + body_size.x - 2, sweep_y), color(accent.r, accent.g, accent.b, 0.10), 1)
            end
        end
    end

    -- Dropdown popup list
    if Library.OpenedDropdown then
        local e = Library.OpenedDropdown
        local list_pos = e.Layout.pos:add(vector2(0, e.Layout.size.y + 3))
        local list_height = math.min(#e.Values, 6) * 18 + 4
        local list_size = vector2(e.Layout.size.x, list_height)
        e.Layout.list_pos, e.Layout.list_size = list_pos, list_size

        draw_chamfered_filled(list_pos, list_size, 6, Library.MainColor)
        draw_chamfered_outline(list_pos, list_size, 6, accent, 1)

        local item_y = 2
        for _, value in ipairs(e.Values) do
            local item_pos, item_size = list_pos:add(vector2(2, item_y)), vector2(list_size.x - 4, 18)
            local is_selected = (e.Multi and e.Value[value]) or (e.Value == value)
            local text_color = is_selected and accent or Library.FontColor
            local hovered = is_mouse_in_rect(item_pos, item_size)

            if hovered then
                render.add_rect_filled(item_pos, item_pos:add(item_size), lerp_color(Library.MainColor, accent, 0.35), 0)
                text_color = Library.FontColor
                if mouse_pressed then
                    if e.Multi then
                        e.Value[value] = not e.Value[value]
                        e:SetValue(e.Value)
                    else
                        e:SetValue(value); e.Open = false; Library.OpenedDropdown = nil
                    end
                end
            elseif is_selected then
                render.add_rect_filled(item_pos, item_pos:add(item_size), lerp_color(Library.MainColor, accent, 0.12), 0)
            end
            render.add_text(item_pos:add(vector2(6, 1)), value, text_color)
            item_y = item_y + 18
        end
    end

    -- Right-click keybind mode menu
    if Library.OpenedKeybindMenu then
        local menu = Library.OpenedKeybindMenu
        local modes = { "Toggle", "Hold", "Always" }
        local menu_h = #modes * 18 + 4
        menu.size = vector2(64, menu_h)

        draw_chamfered_filled(menu.pos, menu.size, 6, Library.MainColor)
        draw_chamfered_outline(menu.pos, menu.size, 6, accent, 1)

        local item_y = 2
        for _, mode in ipairs(modes) do
            local item_pos, item_size = menu.pos:add(vector2(2, item_y)), vector2(menu.size.x - 4, 18)
            local is_selected = menu.obj.Mode == mode
            local text_color = is_selected and accent or Library.FontColor
            if is_mouse_in_rect(item_pos, item_size) then
                render.add_rect_filled(item_pos, item_pos:add(item_size), lerp_color(Library.MainColor, accent, 0.35), 0)
                text_color = Library.FontColor
                if mouse_pressed then menu.obj.Mode = mode; Library.OpenedKeybindMenu = nil end
            end
            render.add_text(item_pos:add(vector2(6, 1)), mode, text_color)
            item_y = item_y + 18
        end
    end

    -- Color picker panel
    if Library.ActiveColorPicker then
        local e = Library.ActiveColorPicker.obj
        local pad, sv_w, sv_h, hue_w, input_h, gap, alpha_h = 6, 120, 120, 15, 20, 6, 12
        local content_start_y = 26
        local total_w = pad + sv_w + gap + hue_w + pad
        local total_h = content_start_y + pad + sv_h + gap + input_h + gap + alpha_h + pad
        local picker_size = vector2(total_w, total_h)
        local picker_pos = e.layout.pos:add(vector2(0, e.layout.size.y + 3))
        e.layout.picker_pos, e.layout.picker_size = picker_pos, picker_size

        draw_chamfered_filled(picker_pos, picker_size, 6, color(0.10, 0.10, 0.11, 1))
        draw_chamfered_outline(picker_pos, picker_size, 6, accent, 1)
        render.add_rect_filled(picker_pos:add(vector2(2,2)), picker_pos:add(vector2(picker_size.x-2, 24)), Library.MainColor, 0)
        render.add_text(picker_pos:add(vector2(7, 5)), e.Text, Library.FontColor)

        local sv_pos = picker_pos:add(vector2(pad, content_start_y + pad))
        local sv_size = vector2(sv_w, sv_h)
        local hue_pos = sv_pos:add(vector2(sv_w + gap, 0))
        local hue_size = vector2(hue_w, sv_h)
        e.layout.sv_pos, e.layout.sv_size, e.layout.hue_pos, e.layout.hue_size = sv_pos, sv_size, hue_pos, hue_size

        local hue_color = hsv_to_rgb(e.Hue, 1, 1)
        render.add_rect_filled(sv_pos, sv_pos:add(sv_size), color(1, 1, 1, 1), 0)
        for i = 0, sv_size.x - 1 do render.add_line(sv_pos:add(vector2(i, 0)), sv_pos:add(vector2(i, sv_size.y)), color(hue_color.r, hue_color.g, hue_color.b, i / sv_size.x), 1) end
        for i = 0, sv_size.y - 1 do render.add_line(sv_pos:add(vector2(0, i)), sv_pos:add(vector2(sv_size.x, i)), color(0, 0, 0, i / sv_size.y), 1) end
        render.add_rect(sv_pos, sv_pos:add(sv_size), Library.Black, 0, 1)

        local cursor_x = sv_pos.x + sv_size.x * e.Saturation
        local cursor_y = sv_pos.y + sv_size.y * (1 - e.ValueHSV)
        render.add_circle(vector2(cursor_x, cursor_y), 4, color(1, 1, 1, 1), 1)
        render.add_circle(vector2(cursor_x, cursor_y), 3, color(0, 0, 0, 1), 1)

        for i = 0, hue_size.y - 1 do render.add_line(hue_pos:add(vector2(0, i)), hue_pos:add(vector2(hue_size.x, i)), hsv_to_rgb(i / hue_size.y, 1, 1), 1) end
        render.add_rect(hue_pos, hue_pos:add(hue_size), Library.Black, 0, 1)
        local hue_cursor_y = hue_pos.y + hue_size.y * e.Hue
        render.add_rect(vector2(hue_pos.x - 1, hue_cursor_y - 2), vector2(hue_pos.x + hue_size.x + 1, hue_cursor_y + 2), color(1, 1, 1, 1), 0, 1)

        local inputs_y = content_start_y + pad + sv_h + gap
        local hex_w = (total_w - 2 * pad - gap) * 0.4
        local rgb_w = (total_w - 2 * pad - gap) * 0.6
        local hex_pos = picker_pos:add(vector2(pad, inputs_y))
        local hex_size = vector2(hex_w, input_h)
        render.add_rect_filled(hex_pos, hex_pos:add(hex_size), color(0.08, 0.08, 0.08, 1), 0)
        render.add_rect(hex_pos, hex_pos:add(hex_size), Library.OutlineColor, 0, 1)
        local hex_str = string.format("#%02X%02X%02X", math.floor(e.Value.r * 255), math.floor(e.Value.g * 255), math.floor(e.Value.b * 255))
        render.add_text(hex_pos:add(vector2(4, 3)), hex_str, Library.FontColor)

        local rgb_pos = hex_pos:add(vector2(hex_w + gap, 0))
        local rgb_size = vector2(rgb_w, input_h)
        render.add_rect_filled(rgb_pos, rgb_pos:add(rgb_size), color(0.08, 0.08, 0.08, 1), 0)
        render.add_rect(rgb_pos, rgb_pos:add(rgb_size), Library.OutlineColor, 0, 1)
        local rgb_str = string.format("%d, %d, %d", math.floor(e.Value.r * 255), math.floor(e.Value.g * 255), math.floor(e.Value.b * 255))
        render.add_text(rgb_pos:add(vector2(4, 3)), rgb_str, Library.FontColor)

        local alpha_y = inputs_y + input_h + gap
        local alpha_pos = picker_pos:add(vector2(pad, alpha_y))
        local alpha_size = vector2(total_w - 2 * pad, alpha_h)
        e.layout.alpha_pos, e.layout.alpha_size = alpha_pos, alpha_size

        draw_checkerboard(alpha_pos, alpha_size, 4)
        if e.EnableAlpha then
            local solid_color = hsv_to_rgb(e.Hue, e.Saturation, e.ValueHSV)
            for i = 0, alpha_size.x - 1 do
                render.add_line(alpha_pos:add(vector2(i, 0)), alpha_pos:add(vector2(i, alpha_size.y)), color(solid_color.r, solid_color.g, solid_color.b, i / alpha_size.x), 1)
            end
            local alpha_cursor_x = alpha_pos.x + alpha_size.x * e.Alpha
            render.add_rect(vector2(alpha_cursor_x - 1, alpha_pos.y), vector2(alpha_cursor_x + 1, alpha_pos.y + alpha_size.y), color(1, 1, 1, 1), 0, 1)
        else
            render.add_rect_filled(alpha_pos, alpha_pos:add(alpha_size), e.Value, 0)
        end
        render.add_rect(alpha_pos, alpha_pos:add(alpha_size), Library.Black, 0, 1)
    end

    -- Notifications: incoming transmissions, sliding in from the top-right
    local screen = get_screen_size()
    local notification_y = 40
    for i = #Library.Notifications, 1, -1 do
        local notif = Library.Notifications[i]
        local time_passed = get_unixtime() - notif.StartTime
        if time_passed > notif.Duration then notif.TargetAlpha = 0 end
        notif.Alpha = notif.Alpha + (notif.TargetAlpha - notif.Alpha) * 0.12
        notif.SlideX = (notif.SlideX or 40) * 0.8

        if notif.TargetAlpha == 0 and notif.Alpha < 0.01 then
            table.remove(Library.Notifications, i)
        else
            local display_text = "> " .. notif.Text
            local notif_size = vector2(render.get_text_size(display_text).x + 30, 26)
            local notif_pos = vector2(screen.x - notif_size.x - 16 + notif.SlideX, notification_y)

            draw_chamfered_filled(notif_pos, notif_size, 6, color(Library.MainColor.r, Library.MainColor.g, Library.MainColor.b, notif.Alpha))
            draw_chamfered_outline(notif_pos, notif_size, 6, color(Library.OutlineColor.r, Library.OutlineColor.g, Library.OutlineColor.b, notif.Alpha), 1)
            draw_hex_filled(notif_pos:add(vector2(15, notif_size.y / 2)), 6, color(accent.r, accent.g, accent.b, notif.Alpha), hex_spin)
            render.add_text(notif_pos:add(vector2(28, 6)), display_text, color(Library.FontColor.r, Library.FontColor.g, Library.FontColor.b, notif.Alpha))

            notification_y = notification_y + notif_size.y + 6
        end
    end

    -- Watermark: status readout badge
    if Library.Watermark.Visible then
        local pos = Library.Watermark.Pos
        local label = string.upper(Library.Watermark.Text)
        local size = vector2(render.get_text_size(label).x + 34, 22)

        draw_chamfered_filled(pos, size, 6, Library.MainColor)
        draw_chamfered_outline(pos, size, 6, accent, 1)
        local core = pos:add(vector2(15, size.y / 2))
        draw_hex_outline(core, 7, color(accent.r, accent.g, accent.b, 0.35), 1, hex_spin)
        draw_hex_filled(core, 4 + pulse * 1.3, accent, hex_spin)
        render.add_text(pos:add(vector2(26, 5)), label, Library.FontColor)
    end

    render_tooltip()
end)

