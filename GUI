function Library:ApplyTheme(name, instant)
    local t = self.Themes[name]
    if not t then return end
    self.CurrentThemeName = name

    local target = {
        FontColor = t.Font, MainColor = t.Main, BackgroundColor = t.Background,
        AccentColor = t.Accent, Accent2Color = t.Accent2 or t.Accent,
        OutlineColor = t.Outline, RiskColor = t.Risk or self.RiskColor,
    }

    if instant then
        for k, v in pairs(target) do self[k] = v end
        self.ThemeTween = nil
    else
        self.ThemeTween = {
            from = {
                FontColor = self.FontColor, MainColor = self.MainColor, BackgroundColor = self.BackgroundColor,
                AccentColor = resolve_color(self.AccentColor), Accent2Color = resolve_color(self.Accent2Color),
                OutlineColor = self.OutlineColor, RiskColor = self.RiskColor,
            },
            to = target, t = 0,
        }
    end
    self:Notify("Theme calibrated: " .. name, 3)
end

function Library:RandomizeTheme()
    local base_hue = math.random()
    local accent = hsv_to_rgb(base_hue, 0.8, 1)
    local accent2 = hsv_to_rgb((base_hue + 0.14) % 1, 0.75, 1)
    local dark = math.random(35, 90) / 1000
    local main = color(dark, dark, dark + 0.015, 1)
    local bg = color(dark * 0.55, dark * 0.55, dark * 0.62, 1)
    local outline = color(dark + 0.09, dark + 0.09, dark + 0.11, 1)
    Library.Themes.Custom = {
        Font = color(1, 1, 1, 1), Main = main, Background = bg,
        Accent = accent, Accent2 = accent2, Outline = outline, Risk = color(1, 0.28, 0.3, 1),
    }
    Library:ApplyTheme("Custom", false)
end

