local function save_config(name)
    if not name or #name == 0 then Library:Notify("Config name cannot be empty.", 5); return end
    local config_data = {}
    for id, obj in pairs(Library.Toggles) do config_data[id] = { value = obj.Value } end
    for id, obj in pairs(Library.Options) do
        if obj.Type == "ColorPicker" then
             config_data[id] = { value = {r=obj.Value.r, g=obj.Value.g, b=obj.Value.b, a=obj.Value.a} }
        else
            config_data[id] = { value = obj.Value }
        end
    end
    
    local json_data = table_to_JSON(config_data)
    file.write(name .. ".json", json_data)
    Library:Notify("Config '"..name.."' saved!", 5)
end

local function load_config(name)
    if not name or #name == 0 then Library:Notify("Config name cannot be empty.", 5); return end
    local file_name = name .. ".json"
    if not file.exists(file_name) then Library:Notify("Config '"..name.."' not found.", 5); return end

    local json_data = file.read(file_name)
    local config_data = JSON_to_table(json_data)

    for id, data in pairs(config_data) do
        local element = Library.Toggles[id] or Library.Options[id]
        if element then
            if element.Type == "ColorPicker" then
                element:SetValue(color(data.value.r, data.value.g, data.value.b, data.value.a))
            else
                element:SetValue(data.value)
            end
        end
    end
    Library:Notify("Config '"..name.."' loaded!", 5)
end

