--------------------------------------------------------------------------
--  Math / color helpers
--------------------------------------------------------------------------

local function rgb_to_hsv(c)
    local r, g, b = c.r, c.g, c.b
    local maxc = math.max(r, g, b)
    local minc = math.min(r, g, b)
    local h, s, v = 0, 0, maxc
    local diff = maxc - minc
    if maxc ~= 0 then s = diff / maxc else return 0, 0, 0 end
    if diff > 1e-5 then
        if maxc == r then h = (g - b) / diff
        elseif maxc == g then h = 2 + (b - r) / diff
        else h = 4 + (r - g) / diff end
        h = h / 6
        if h < 0 then h = h + 1 end
    end
    return h, s, v
end

local function hsv_to_rgb(h, s, v, a)
    local r, g, b
    local i = math.floor(h * 6)
    local f = h * 6 - i
    local p = v * (1 - s)
    local q = v * (1 - f * s)
    local t = v * (1 - (1 - f) * s)
    i = i % 6
    if i == 0 then r, g, b = v, t, p elseif i == 1 then r, g, b = q, v, p elseif i == 2 then r, g, b = p, v, t
    elseif i == 3 then r, g, b = p, q, v elseif i == 4 then r, g, b = t, p, v elseif i == 5 then r, g, b = v, p, q end
    return color(r, g, b, a or 1)
end

local function resolve_color(c)
    if type(c) == "function" then return c() end
    return c
end

local function lerp(a, b, t) return a + (b - a) * t end

local function lerp_color(a, b, t)
    a, b = resolve_color(a), resolve_color(b)
    return color(lerp(a.r, b.r, t), lerp(a.g, b.g, t), lerp(a.b, b.b, t), lerp(a.a, b.a, t))
end

local function ease_out_cubic(t) return 1 - (1 - t) ^ 3 end

local function is_mouse_in_rect(pos, size)
    if not pos or not size then return false end
    local mouse_pos = input.get_mouse_position()
    return mouse_pos.x >= pos.x and mouse_pos.x <= pos.x + size.x and mouse_pos.y >= pos.y and mouse_pos.y <= pos.y + size.y
end

local function get_clipped_text(text, max_width)
    text = tostring(text)
    if render.get_text_size(text).x <= max_width then return text end
    local clipped_text = text
    while render.get_text_size(clipped_text .. "...").x > max_width and #clipped_text > 0 do
        clipped_text = string.sub(clipped_text, 1, -2)
    end
    return clipped_text .. "..."
end

local function spaced_text(s)
    local out = {}
    for i = 1, #s do
        local ch = s:sub(i, i)
        table.insert(out, ch)
    end
    return table.concat(out, " ")
end

local function draw_checkerboard(pos, size, square_size)
    local c1 = color(0.8, 0.8, 0.8, 1)
    local c2 = color(0.6, 0.6, 0.6, 1)
    for y = 0, math.ceil(size.y / square_size) - 1 do
        for x = 0, math.ceil(size.x / square_size) - 1 do
            local p = pos:add(vector2(x * square_size, y * square_size))
            local s = vector2(math.min(square_size, size.x - x * square_size), math.min(square_size, size.y - y * square_size))
            local current_c = (x + y) % 2 == 0 and c1 or c2
            render.add_rect_filled(p, p:add(s), current_c, 0)
        end
    end
end

--------------------------------------------------------------------------
--  Alien-tech geometry primitives: chamfered plates, hexes, HUD brackets
--------------------------------------------------------------------------

local function chamfered_points(pos, size, chamfer)
    local c = math.min(chamfer, size.x / 2, size.y / 2)
    local x1, y1 = pos.x, pos.y
    local x2, y2 = pos.x + size.x, pos.y + size.y
    return {
        vector2(x1 + c, y1), vector2(x2 - c, y1),
        vector2(x2, y1 + c), vector2(x2, y2 - c),
        vector2(x2 - c, y2), vector2(x1 + c, y2),
        vector2(x1, y2 - c), vector2(x1, y1 + c),
    }
end

local function draw_chamfered_outline(pos, size, chamfer, col, thickness)
    local pts = chamfered_points(pos, size, chamfer)
    for i = 1, #pts do
        render.add_line(pts[i], pts[(i % #pts) + 1], col, thickness or 1)
    end
end

local function draw_chamfered_filled(pos, size, chamfer, col)
    local pts = chamfered_points(pos, size, chamfer)
    local center = vector2(pos.x + size.x / 2, pos.y + size.y / 2)
    for i = 1, #pts do
        render.add_triangle_filled(center, pts[i], pts[(i % #pts) + 1], col)
    end
end

local function hex_points(center, radius, rotation_deg)
    local pts = {}
    for i = 0, 5 do
        local ang = math.rad(60 * i + (rotation_deg or 0))
        table.insert(pts, vector2(center.x + radius * math.cos(ang), center.y + radius * math.sin(ang)))
    end
    return pts
end

local function draw_hex_outline(center, radius, col, thickness, rotation_deg)
    local pts = hex_points(center, radius, rotation_deg)
    for i = 1, 6 do render.add_line(pts[i], pts[(i % 6) + 1], col, thickness or 1) end
end

local function draw_hex_filled(center, radius, col, rotation_deg)
    local pts = hex_points(center, radius, rotation_deg)
    for i = 1, 6 do render.add_triangle_filled(center, pts[i], pts[(i % 6) + 1], col) end
end

-- Targeting-reticle style corner brackets, drawn slightly outside (or inside,
-- via a negative inset) the given rect.
local function draw_corner_brackets(pos, size, col, len, thickness, inset)
    inset = inset or 0; len = len or 10; thickness = thickness or 2
    local x1, y1 = pos.x - inset, pos.y - inset
    local x2, y2 = pos.x + size.x + inset, pos.y + size.y + inset
    render.add_line(vector2(x1, y1), vector2(x1 + len, y1), col, thickness)
    render.add_line(vector2(x1, y1), vector2(x1, y1 + len), col, thickness)
    render.add_line(vector2(x2, y1), vector2(x2 - len, y1), col, thickness)
    render.add_line(vector2(x2, y1), vector2(x2, y1 + len), col, thickness)
    render.add_line(vector2(x1, y2), vector2(x1 + len, y2), col, thickness)
    render.add_line(vector2(x1, y2), vector2(x1, y2 - len), col, thickness)
    render.add_line(vector2(x2, y2), vector2(x2 - len, y2), col, thickness)
    render.add_line(vector2(x2, y2), vector2(x2, y2 - len), col, thickness)
end

-- Cheap layered-outline "bloom" approximation for an energy-field glow.
local function glow_rect_outline(pos, size, col, layers, base_alpha, spread)
    layers = layers or 3; spread = spread or 3
    for i = layers, 1, -1 do
        local o = i * spread
        local a = base_alpha / i
        render.add_rect(pos:add(vector2(-o, -o)), pos:add(size):add(vector2(o, o)), color(col.r, col.g, col.b, a), 0, 1)
    end
end

local function draw_grid_pattern(pos, size, col, spacing)
    local c = color(col.r, col.g, col.b, 0.05)
    local x = spacing
    while x < size.x do
        render.add_line(pos:add(vector2(x, 0)), pos:add(vector2(x, size.y)), c, 1)
        x = x + spacing
    end
    local y = spacing
    while y < size.y do
        render.add_line(pos:add(vector2(0, y)), pos:add(vector2(size.x, y)), c, 1)
        y = y + spacing
    end
end

-- Shared layout constants for the rail-based window shell
local RAIL_W, CONTENT_PAD, COL_GAP, TITLE_H = 62, 10, 8, 32

local function get_group_width(window)
    local content_w = window.Size.x - RAIL_W - CONTENT_PAD * 2
    return (content_w - COL_GAP) / 2
end

local function get_group_inner_width(window)
    return get_group_width(window) - 8
end

