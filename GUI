-- =====================================================================
local function clamp01(x) return x < 0 and 0 or (x > 1 and 1 or x) end
local function with_alpha(c, a) return color(c.r, c.g, c.b, clamp01(a)) end
local function mix(a, b, t) t = clamp01(t); return color(a.r + (b.r - a.r) * t, a.g + (b.g - a.g) * t, a.b + (b.b - a.b) * t, 1) end
local function shade(c, m) return color(clamp01(c.r * m), clamp01(c.g * m), clamp01(c.b * m), c.a or 1) end

local function update_clock()
    local now = get_unixtime()
    if not Library.ClockLast then
        Library.ClockLast = now
        Library.ClockFrames = 0
    end

    local dt = now - Library.ClockLast
    if dt > 0 then
        local frames = Library.ClockFrames > 0 and Library.ClockFrames or 1
        local step = dt / frames
        if step > 0.05 then step = 0.05 end
        if step < 0.0005 then step = 0.0005 end
        Library.ClockStep = Library.ClockStep + (step - Library.ClockStep) * 0.20
        Library.ClockLast = now
        Library.ClockFrames = 0
    end

    Library.ClockFrames = Library.ClockFrames + 1
    Library.Clock = Library.Clock + Library.ClockStep
end

-- Smoother sine-wave pulse for glows and blinks
local function pulse(speed, min, max)
    min = min or 0.3
    max = max or 0.7
    local val = (math.sin(Library.Clock * (speed or 2)) + 1) / 2
    return min + (max - min) * val
end

local function noise(n)
    n = (n * 1103515245 + 12345) % 2147483648
    return (n / 2147483648)
end

local function glitching(seed, rate)
    if Library.GlitchLevel <= 0 then return false end
    local slot = math.floor(Library.Clock * (rate or 9)) + seed * 733
    return noise(slot) < 0.055 * Library.GlitchLevel
end

-- Smooth corner fill
local function notch_fill(pos, size, c, cut)
    cut = cut or 12
    local h = math.max(1, size.y)
    local y = 0
    while y < h do
        local s = (y < cut) and 1 or 6
        if s > h - y then s = h - y end
        local right = (y < cut) and (cut - y) or 0
        render.add_rect_filled(vector2(pos.x, pos.y + y), vector2(pos.x + size.x - right, pos.y + y + s), c, 0)
        y = y + s
    end
end

local function notch_frame(pos, size, c, cut, th)
    cut = cut or 12
    th = th or 1
    local x1, y1 = pos.x, pos.y
    local x2, y2 = pos.x + size.x, pos.y + size.y
    render.add_line(vector2(x1, y1), vector2(x2 - cut, y1), c, th)
    render.add_line(vector2(x2 - cut, y1), vector2(x2, y1 + cut), c, th)
    render.add_line(vector2(x2, y1 + cut), vector2(x2, y2), c, th)
    render.add_line(vector2(x2, y2), vector2(x1, y2), c, th)
    render.add_line(vector2(x1, y2), vector2(x1, y1), c, th)
end

local function hazard(pos, size, c, spacing, th)
    spacing = spacing or 9
    th = th or 3
    local h = size.y
    local right = pos.x + size.x
    local x0 = pos.x - h
    while x0 < right do
        local x1, y1 = x0, pos.y + h
        local x2, y2 = x0 + h, pos.y
        if x1 < pos.x then y1 = y1 - (pos.x - x1); x1 = pos.x end
        if x2 > right then y2 = y2 + (x2 - right); x2 = right end
        if x1 < x2 then render.add_line(vector2(x1, y1), vector2(x2, y2), c, th) end
        x0 = x0 + spacing
    end
end

local function corner_marks(pos, size, c, len, th)
    len = len or 7
    th = th or 1
    local x1, y1, x2, y2 = pos.x, pos.y, pos.x + size.x, pos.y + size.y
    render.add_line(vector2(x1, y1), vector2(x1 + len, y1), c, th)
    render.add_line(vector2(x1, y1), vector2(x1, y1 + len), c, th)
    render.add_line(vector2(x1, y2), vector2(x1 + len, y2), c, th)
    render.add_line(vector2(x1, y2), vector2(x1, y2 - len), c, th)
    render.add_line(vector2(x2, y2), vector2(x2 - len, y2), c, th)
    render.add_line(vector2(x2, y2), vector2(x2, y2 - len), c, th)
end

local function scanlines(pos, size, c, spacing, alpha)
    if Library.GlitchLevel <= 0 then return end
    spacing = spacing or 3
    for i = 0, math.floor(size.y), spacing do
        render.add_line(pos:add(vector2(0, i)), pos:add(vector2(size.x, i)), with_alpha(c, alpha or 0.05), 1)
    end
end

-- Chromatic aberration on text
local function glitch_text(pos, text, c, seed)
    if glitching(seed) then
        local off = 1 + math.floor(noise(seed * 31 + math.floor(Library.Clock * 9)) * 2)
        render.add_text(pos:add(vector2(-off, 0)), text, with_alpha(Library.RiskColor, 0.75))
        render.add_text(pos:add(vector2(off, 0)), text, with_alpha(Library.SecondaryColor, 0.75))
    end
    render.add_text(pos, text, c)
end

local function tick_marks(pos, size, c, count)
    count = count or 10
    for i = 0, count do
        local x = pos.x + (size.x * i / count)
        local tall = (i % 5 == 0)
        render.add_line(vector2(x, pos.y + size.y), vector2(x, pos.y + size.y + (tall and 4 or 2)), with_alpha(c, tall and 0.8 or 0.4), 1)
    end
end

local ElementMethods = {}
function ElementMethods:OnChanged(func) self.OnChangedFunc = func; return self end
function ElementMethods:SetTooltip(text) self.Tooltip = text; return self end

local function CreateElement(base, methods)
    if type(methods) == "table" then
        for k, v in pairs(methods) do base[k] = v end
    end
    return setmetatable(base, { __index = ElementMethods })
end

local ToggleMethods = {}
function ToggleMethods:SetValue(val)
    self.Value = val
    if self.Callback then self.Callback(self.Value) end
    if self.OnChangedFunc then self.OnChangedFunc(self.Value) end
end

local SliderMethods = {}
function SliderMethods:SetValue(val)
    local rounded_val = tonumber(string.format("%." .. (self.Rounding or 0) .. "f", val))
    self.Value = math.clamp(rounded_val, self.Min, self.Max)
    if self.Callback then self.Callback(self.Value) end
    if self.OnChangedFunc then self.OnChangedFunc(self.Value) end
end

