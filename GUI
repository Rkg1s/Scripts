function ColorPickerMethods:SetValue(val)
    self.Value = val
    if self.Callback then self.Callback(self.Value) end
    if self.OnChangedFunc then self.OnChangedFunc(self.Value) end
    local h, s, v = rgb_to_hsv(val)
    self.Hue, self.Saturation, self.ValueHSV = h, s, v
    self.Alpha = val.a
end

--------------------------------------------------------------------------
--  Window / Tab / Groupbox / Element construction
--------------------------------------------------------------------------

function Library:CreateWindow(config)
    local window = {
        Title = config.Title or "Window",
        Pos = config.Center and vector2(get_screen_size().x / 2 - (config.Size.x / 2), get_screen_size().y / 2 - (config.Size.y / 2)) or vector2(175, 50),
        Size = config.Size or vector2(640, 540),
        Visible = config.AutoShow or false,
        Tabs = {},
        ActiveTab = nil,
    }

    function window:AddTab(name)
        local tab = { Name = name, Parent = window, Groupboxes = {} }

        function tab:AddLeftGroupbox(name, info) return self:AddGroupbox({ Name = name, Side = "Left", Dependencies = info and info.Dependencies or nil }) end
        function tab:AddRightGroupbox(name, info) return self:AddGroupbox({ Name = name, Side = "Right", Dependencies = info and info.Dependencies or nil }) end

        function tab:AddGroupbox(info)
            local groupbox = { Name = info.Name, Side = info.Side or "Left", Parent = tab, Elements = {}, Dependencies = info.Dependencies }

            function groupbox:IsVisible()
                if not self.Dependencies then return true end
                for _, dep in ipairs(self.Dependencies) do
                    if dep[1] and dep[1].Value ~= dep[2] then return false end
                end
                return true
            end

            function groupbox:AddToggle(id, info)
                local el = CreateElement({ Id=id, Type="Toggle", Text=info.Text, Value=info.Default or false, Callback=info.Callback, Height=24, Tooltip=info.Tooltip, Risky=info.Risky, AnimT = (info.Default and 1 or 0) }, ToggleMethods)
                table.insert(self.Elements, el); Library.Toggles[id] = el; return el
            end
            function groupbox:AddSlider(id, info)
                local el = CreateElement({ Id=id, Type="Slider", Text=info.Text, Value=info.Default or 0, Min=info.Min or 0, Max=info.Max or 100, Rounding=info.Rounding or 0, Suffix=info.Suffix or "", Callback=info.Callback, Height=44, Tooltip=info.Tooltip }, SliderMethods)
                table.insert(self.Elements, el); Library.Options[id] = el; return el
            end
            function groupbox:AddButton(info)
                local el = { Type="Button", Text=info.Text, Func=info.Func, Height=26, DoubleClick=info.DoubleClick, LastClick=0, Tooltip=info.Tooltip }
                table.insert(self.Elements, el); return el
            end
            function groupbox:AddDropdown(id, info)
                local el = CreateElement({ Id=id, Type="Dropdown", Text=info.Text, Value = info.Multi and (info.Default or {}) or (info.Default and info.Values[info.Default] or info.Values[1]), Values=info.Values, Open=false, Callback=info.Callback, Height=47, Multi=info.Multi, Tooltip=info.Tooltip }, DropdownMethods)
                table.insert(self.Elements, el); Library.Options[id] = el; return el
            end
            function groupbox:AddInput(id, info)
                local el = CreateElement({ Id=id, Type="Input", Text=info.Text, Value=info.Default or "", Placeholder=info.Placeholder or "", Callback=info.Callback, Height=52, Tooltip=info.Tooltip }, InputMethods)
                table.insert(self.Elements, el); Library.Options[id] = el; return el
            end
            function groupbox:AddKeyPicker(id, info)
                local el = CreateElement({ Id=id, Type="KeyPicker", Text=info.Text, Value=info.Default or "...", Mode=info.Mode or "Toggle", State=false, Callback=info.Callback, Picking=false, Height=52, Tooltip=info.Tooltip }, KeyPickerMethods)
                table.insert(self.Elements, el); Library.Options[id] = el; table.insert(Library.Keybinds, el); return el
            end
            function groupbox:AddColorPicker(id, info)
                local val = info.Default or color(1, 1, 1, 1)
                local h, s, v = rgb_to_hsv(val)
                local el = CreateElement({ Id=id, Type="ColorPicker", Text=info.Text, Value=val, Open=false, Callback=info.Callback, Height=52, Hue=h, Saturation=s, ValueHSV=v, Alpha=val.a, EnableAlpha=info.EnableAlpha, Tooltip=info.Tooltip }, ColorPickerMethods)
                table.insert(self.Elements, el); Library.Options[id] = el; return el
            end
            function groupbox:AddDivider(height) local el = { Type="Divider", Height=height or 14 }; table.insert(self.Elements, el); return el end
            function groupbox:AddLabel(text) local el = { Type="Label", Text=text, Height=20 }; table.insert(self.Elements, el); return el end

            function groupbox:AddThemeGallery()
                local window_ref = self.Parent.Parent
                local avail_w = get_group_inner_width(window_ref)
                local card_w, card_h, gap = 104, 58, 8
                local names = {}
                for n, _ in pairs(Library.Themes) do table.insert(names, n) end
                table.sort(names)
                local columns = math.max(1, math.floor((avail_w + gap) / (card_w + gap)))
                local rows = math.ceil(#names / columns)
                local height = rows * (card_h + gap) - gap + 6
                local el = { Type = "ThemeGallery", Height = height, Names = names, Columns = columns, CardW = card_w, CardH = card_h, Gap = gap }
                table.insert(self.Elements, el); return el
            end

            table.insert(self.Groupboxes, groupbox); return groupbox
        end

        table.insert(self.Tabs, tab)
        if not self.ActiveTab then self.ActiveTab = tab end
        return tab
    end

    table.insert(Library.Windows, window)
    return window
end

function Library:Notify(text, duration)
    table.insert(self.Notifications, { Text = text, Duration = duration or 5, StartTime = get_unixtime(), Alpha = 0, TargetAlpha = 1, SlideX = 40 })
end
function Library:SetWatermark(text) self.Watermark.Text = text; self.Watermark.Visible = true end

--------------------------------------------------------------------------
--  Tooltip
--------------------------------------------------------------------------

local function render_tooltip()
    if Library.Tooltip and Library.Tooltip.Text then
        local mouse_pos = input.get_mouse_position()
        local text_size = render.get_text_size(Library.Tooltip.Text)
        local tooltip_size = vector2(text_size.x + 14, text_size.y + 10)
        local tooltip_pos = mouse_pos:add(vector2(16, 16))

        render.add_rect_filled(tooltip_pos:add(vector2(2, 2)), tooltip_pos:add(tooltip_size):add(vector2(2, 2)), color(0, 0, 0, 0.35), 4)
        draw_chamfered_filled(tooltip_pos, tooltip_size, 4, Library.MainColor)
        draw_chamfered_outline(tooltip_pos, tooltip_size, 4, Library.AccentColor, 1)
        render.add_text(tooltip_pos:add(vector2(7, 5)), Library.Tooltip.Text, Library.FontColor)
    end
end

--------------------------------------------------------------------------
--  Main render loop
--------------------------------------------------------------------------

hook.add("render", "xenotech_ui_render", function()
    local mouse_pos, mouse_pressed, mouse_down = input.get_mouse_position(), input.is_key_pressed(0x01), input.key_down(0x01)
    local r_mouse_pressed = input.is_key_pressed(0x02)

    if Library.ActiveKeyPicker then
        for key, name in pairs(KEY_NAMES) do
            if input.is_key_pressed(key) then
                Library.ActiveKeyPicker.obj:SetValue(name)
                Library.ActiveKeyPicker.obj.Picking = false
                Library.ActiveKeyPicker = nil
                Library:Notify("Key bound to " .. name)
                break
            end
        end
    elseif Library.ActiveInput then
        for key, char in pairs(CHAR_MAP_NORMAL) do
            if input.is_key_pressed(key) then
                if input.key_down(0x10) and CHAR_MAP_SHIFT[key] then char = CHAR_MAP_SHIFT[key] end
                Library.ActiveInput:SetValue(Library.ActiveInput.Value .. char)
            end
        end
        if input.is_key_pressed(0x08) then
            local str = Library.ActiveInput.Value
            if #str > 0 then Library.ActiveInput:SetValue(string.sub(str, 1, -2)) end
        end
    end

    for _, bind in ipairs(Library.Keybinds) do
        local key_code = KEY_CODES[bind.Value]
        if key_code then
            if bind.Mode == "Always" then bind.State = true
            elseif bind.Mode == "Hold" then bind.State = input.key_down(key_code)
            elseif bind.Mode == "Toggle" then
                if input.is_key_pressed(key_code) then bind.State = not bind.State end
            end
        end
    end

    Library.Hue = (Library.Hue + 0.0022) % 1
    Library.CurrentRainbowColor = hsv_to_rgb(Library.Hue, 0.8, 1)

    if Library.ThemeTween then
        local tw = Library.ThemeTween
        tw.t = math.min(tw.t + 0.07, 1)
        local eased = ease_out_cubic(tw.t)
        for k, target_v in pairs(tw.to) do
            if type(target_v) ~= "function" then
                Library[k] = lerp_color(tw.from[k], target_v, eased)
            else
                Library[k] = target_v
            end
        end
        if tw.t >= 1 then Library.ThemeTween = nil end
    end

    local function get_accent() if type(Library.AccentColor) == "function" then return Library.AccentColor() end; return Library.AccentColor end
    local function get_accent2() if type(Library.Accent2Color) == "function" then return Library.Accent2Color() end; return Library.Accent2Color end
    local accent = get_accent()
    local accent2 = get_accent2()
    local pulse = 0.5 + 0.5 * math.sin(get_unixtime() * 5)
    local hex_spin = (get_unixtime() * 12) % 360

    Library.ModalOpen = Library.OpenedDropdown or Library.ActiveColorPicker or Library.ActiveKeyPicker or Library.ActiveInput or Library.OpenedKeybindMenu

    if mouse_pressed and Library.ModalOpen then
        if Library.OpenedDropdown and not (is_mouse_in_rect(Library.OpenedDropdown.Layout.pos, Library.OpenedDropdown.Layout.size) or is_mouse_in_rect(Library.OpenedDropdown.Layout.list_pos, Library.OpenedDropdown.Layout.list_size)) then
            Library.OpenedDropdown.Open = false; Library.OpenedDropdown = nil
        end
        if Library.ActiveColorPicker and not is_mouse_in_rect(Library.ActiveColorPicker.layout.picker_pos, Library.ActiveColorPicker.layout.picker_size) then
            Library.ActiveColorPicker.obj.Open = false; Library.ActiveColorPicker = nil
        end
        if Library.ActiveKeyPicker and not is_mouse_in_rect(Library.ActiveKeyPicker.layout.pos, Library.ActiveKeyPicker.layout.size) then
            Library.ActiveKeyPicker.obj.Picking = false; Library.ActiveKeyPicker = nil
        end
        if Library.ActiveInput and not is_mouse_in_rect(Library.ActiveInput.layout.pos, Library.ActiveInput.layout.size) then
            Library.ActiveInput = nil
        end
        if Library.OpenedKeybindMenu and not is_mouse_in_rect(Library.OpenedKeybindMenu.pos, Library.OpenedKeybindMenu.size) then
            Library.OpenedKeybindMenu = nil
        end
    end

    if Library.DraggingWindow then
        if mouse_down then Library.DraggingWindow.Pos = mouse_pos:subtract(Library.DragOffset) else Library.DraggingWindow = nil end
    end
    if Library.ActiveSlider then
        if mouse_down then
            local s, l = Library.ActiveSlider.obj, Library.ActiveSlider.layout
            local r = (math.clamp(mouse_pos.x, l.pos.x, l.pos.x + l.size.x) - l.pos.x) / l.size.x
            local v = s.Min + (s.Max - s.Min) * r
            if s.Value ~= v then s:SetValue(v) end
        else
            Library.ActiveSlider = nil
        end
    end

    if Library.ActiveColorPicker and mouse_down then
        local cp = Library.ActiveColorPicker.obj; local layout = Library.ActiveColorPicker.layout
        if is_mouse_in_rect(layout.sv_pos, layout.sv_size) then
            cp.Saturation = math.clamp((mouse_pos.x - layout.sv_pos.x) / layout.sv_size.x, 0, 1)
            cp.ValueHSV = 1 - math.clamp((mouse_pos.y - layout.sv_pos.y) / layout.sv_size.y, 0, 1)
            cp:SetValue(hsv_to_rgb(cp.Hue, cp.Saturation, cp.ValueHSV, cp.Alpha))
        elseif is_mouse_in_rect(layout.hue_pos, layout.hue_size) then
            cp.Hue = math.clamp((mouse_pos.y - layout.hue_pos.y) / layout.hue_size.y, 0, 1)
            cp:SetValue(hsv_to_rgb(cp.Hue, cp.Saturation, cp.ValueHSV, cp.Alpha))
        elseif cp.EnableAlpha and is_mouse_in_rect(layout.alpha_pos, layout.alpha_size) then
            cp.Alpha = math.clamp((mouse_pos.x - layout.alpha_pos.x) / layout.alpha_size.x, 0, 1)
            cp:SetValue(hsv_to_rgb(cp.Hue, cp.Saturation, cp.ValueHSV, cp.Alpha))
        end
    end

    local watermark_label = string.upper(Library.Watermark.Text)
    local watermark_size = vector2(render.get_text_size(watermark_label).x + 34, 22)
    if not Library.DraggingWatermark and mouse_pressed and is_mouse_in_rect(Library.Watermark.Pos, watermark_size) then
        Library.DraggingWatermark = true; Library.DragOffset = mouse_pos:subtract(Library.Watermark.Pos)
    end
    if Library.DraggingWatermark then
        if mouse_down then Library.Watermark.Pos = mouse_pos:subtract(Library.DragOffset) else Library.DraggingWatermark = false end
    end

    local can_interact = not Library.ModalOpen
    Library.Tooltip = nil

    if menu_active() then
        for _, window in ipairs(Library.Windows) do
            if window.Visible then
                -- energy halo + drop shadow
                glow_rect_outline(window.Pos, window.Size, accent, 3, 0.10, 3)
                for i = 3, 1, -1 do
                    local off = i * 2
                    local sp = window.Pos:add(vector2(off, off))
                    render.add_rect_filled(sp, sp:add(window.Size), color(0, 0, 0, 0.05 * i), 0)
                end

                -- chamfered hull + targeting brackets
                draw_chamfered_filled(window.Pos, window.Size, 16, Library.MainColor)
                draw_chamfered_outline(window.Pos, window.Size, 16, accent, 1)
                draw_corner_brackets(window.Pos, window.Size, accent2, 16, 2, 5)

                -- title bar
                local title_pos, title_size = window.Pos, vector2(window.Size.x, TITLE_H)
                if not Library.DraggingWindow and mouse_pressed and is_mouse_in_rect(title_pos, title_size) and not Library.ModalOpen then
                    Library.DraggingWindow, Library.DragOffset = window, mouse_pos:subtract(window.Pos)
                end
                for i = 0, TITLE_H - 2 do
                    local lt = i / (TITLE_H - 2)
                    render.add_line(window.Pos:add(vector2(2, 1 + i)), window.Pos:add(vector2(window.Size.x - 2, 1 + i)), lerp_color(Library.BackgroundColor, Library.MainColor, lt), 1)
                end
                local core_center = window.Pos:add(vector2(18, TITLE_H / 2))
                draw_hex_outline(core_center, 9, color(accent2.r, accent2.g, accent2.b, 0.35), 1, hex_spin)
                draw_hex_filled(core_center, 5 + pulse * 1.3, accent2, hex_spin)
                render.add_text(window.Pos:add(vector2(32, 8)), spaced_text(string.upper(window.Title)), Library.FontColor)
                local theme_tag = string.upper(Library.CurrentThemeName)
                local tag_size = render.get_text_size(theme_tag)
                render.add_text(window.Pos:add(vector2(window.Size.x - tag_size.x - 14, 8)), theme_tag, Library.OutlineColor)
                render.add_line(window.Pos:add(vector2(4, TITLE_H - 1)), window.Pos:add(vector2(window.Size.x - 4, TITLE_H - 1)), color(accent.r, accent.g, accent.b, 0.4), 1)

                -- body: left icon rail + content panel
                local body_pos = window.Pos:add(vector2(0, TITLE_H))
                local body_size = window.Size:subtract(vector2(0, TITLE_H))
                render.add_rect_filled(body_pos, body_pos:add(vector2(RAIL_W, body_size.y)), Library.BackgroundColor, 0)
                draw_grid_pattern(body_pos, vector2(RAIL_W, body_size.y), Library.OutlineColor, 22)
                render.add_line(body_pos:add(vector2(RAIL_W, 0)), body_pos:add(vector2(RAIL_W, body_size.y)), Library.OutlineColor, 1)

                local rail_y = 14
                for _, tab in ipairs(window.Tabs) do
                    local is_active = (window.ActiveTab == tab)
                    local hex_center = body_pos:add(vector2(RAIL_W / 2, rail_y + 20))
                    local hit_pos, hit_size = vector2(hex_center.x - 20, hex_center.y - 20), vector2(40, 40)
                    local hovered = is_mouse_in_rect(hit_pos, hit_size)

                    if is_active then
                        render.add_rect_filled(body_pos:add(vector2(0, rail_y)), body_pos:add(vector2(3, rail_y + 40)), accent, 0)
                        draw_hex_outline(hex_center, 25, color(accent.r, accent.g, accent.b, 0.25 + 0.15 * pulse), 1, 0)
                    end
                    draw_hex_filled(hex_center, 19, is_active and Library.MainColor or (hovered and Library.MainColor or Library.BackgroundColor), 0)
                    draw_hex_outline(hex_center, 19, is_active and accent or Library.OutlineColor, is_active and 2 or 1, 0)

                    local abbr = string.upper(string.sub(tab.Name, 1, 2))
                    local abbr_size = render.get_text_size(abbr)
                    render.add_text(vector2(hex_center.x - abbr_size.x / 2, hex_center.y - abbr_size.y / 2), abbr, is_active and accent or Library.FontColor)

                    if hovered then Library.Tooltip = { Text = tab.Name } end
                    if not Library.DraggingWindow and mouse_pressed and hovered and can_interact then window.ActiveTab = tab end

                    rail_y = rail_y + 40 + 12
                end

                local content_area_pos = body_pos:add(vector2(RAIL_W + CONTENT_PAD, CONTENT_PAD))
                local content_area_size = vector2(body_size.x - RAIL_W - CONTENT_PAD * 2, body_size.y - CONTENT_PAD * 2)
                draw_grid_pattern(content_area_pos, content_area_size, Library.OutlineColor, 28)

                if window.ActiveTab then
                    local left_y, right_y = 0, 0
                    for _, groupbox in ipairs(window.ActiveTab.Groupboxes) do
                        if groupbox:IsVisible() then
                            local group_w = get_group_width(window)
                            local side_offset = (groupbox.Side == "Left") and 0 or (group_w + COL_GAP)
                            local y_offset = (groupbox.Side == "Left") and left_y or right_y

                            local group_pos = content_area_pos:add(vector2(side_offset, y_offset))
                            local current_y = 26
                            for _, e in ipairs(groupbox.Elements) do current_y = current_y + e.Height end
                            local group_size = vector2(group_w, current_y + 6)

                            draw_chamfered_filled(group_pos, group_size, 9, Library.BackgroundColor)
                            draw_chamfered_outline(group_pos, group_size, 9, Library.OutlineColor, 1)
                            render.add_rect_filled(group_pos:add(vector2(1, 1)), group_pos:add(vector2(4, group_size.y - 1)), accent, 0)
                            render.add_text(group_pos:add(vector2(10, 7)), "// " .. string.upper(groupbox.Name), Library.FontColor)

                            local element_y = 26
                            for _, element in ipairs(groupbox.Elements) do
                                local element_pos = group_pos:add(vector2(8, element_y))
                                local element_full_width_size = vector2(group_size.x - 16, element.Height)
                                if is_mouse_in_rect(element_pos, element_full_width_size) and element.Tooltip then
                                    Library.Tooltip = { Text = element.Tooltip, Element = element }
                                end

                                if element.Type == "Toggle" then
                                    local target_t = element.Value and 1 or 0
                                    element.AnimT = (element.AnimT or target_t) + (target_t - (element.AnimT or target_t)) * 0.35
                                    local track_pos, track_size = element_pos:add(vector2(0, 3)), vector2(30, 15)
                                    draw_chamfered_filled(track_pos, track_size, 4, Library.MainColor)
                                    draw_chamfered_outline(track_pos, track_size, 4, lerp_color(Library.OutlineColor, accent, element.AnimT), 1)
                                    local core_x = track_pos.x + 7 + (track_size.x - 14) * element.AnimT
                                    local core_center = vector2(core_x, track_pos.y + track_size.y / 2)
                                    if element.AnimT > 0.05 then
                                        draw_hex_outline(core_center, 7.5, color(accent.r, accent.g, accent.b, 0.3 * element.AnimT), 1, hex_spin)
                                    end
                                    draw_hex_filled(core_center, 4.5, lerp_color(Library.OutlineColor, accent, element.AnimT), 0)
                                    draw_hex_outline(core_center, 4.5, Library.Black, 1, 0)
                                    render.add_text(element_pos:add(vector2(38, 2)), element.Text, element.Risky and Library.RiskColor or Library.FontColor)
                                    if not Library.DraggingWindow and mouse_pressed and is_mouse_in_rect(element_pos, vector2(group_size.x - 16, 18)) and can_interact then
                                        element:SetValue(not element.Value)
                                    end

                                elseif element.Type == "Slider" then
                                    local s_pos, s_size = element_pos:add(vector2(0, 20)), vector2(group_size.x - 16, 15)
                                    render.add_text(element_pos, element.Text, Library.FontColor)
                                    draw_chamfered_filled(s_pos, s_size, 5, Library.MainColor)
                                    local ratio = (element.Value - element.Min) / (element.Max - element.Min)
                                    local fill_w = math.max(s_size.x * ratio, 14)
                                    for i = 0, fill_w - 1 do
                                        local lt = i / math.max(fill_w - 1, 1)
                                        render.add_line(s_pos:add(vector2(i, 1)), s_pos:add(vector2(i, s_size.y - 1)), lerp_color(accent, accent2, lt), 1)
                                    end
                                    for p = 0, 2 do
                                        local phase = (get_unixtime() * 0.5 + p / 3) % 1
                                        local px = s_pos.x + fill_w * phase
                                        if px >= s_pos.x + 2 and px <= s_pos.x + fill_w - 2 then
                                            render.add_circle(vector2(px, s_pos.y + s_size.y / 2), 1.6, Library.FontColor, 1)
                                        end
                                    end
                                    draw_chamfered_outline(s_pos, s_size, 5, Library.OutlineColor, 1)
                                    local val_text = tostring(element.Value) .. element.Suffix
                                    local val_size = render.get_text_size(val_text)
                                    render.add_text(s_pos:add(vector2(s_size.x - val_size.x - 6, 1)), val_text, Library.FontColor)
                                    if not Library.DraggingWindow and not Library.ActiveSlider and mouse_pressed and is_mouse_in_rect(s_pos, s_size) and can_interact then
                                        Library.ActiveSlider = { obj = element, layout = { pos = s_pos, size = s_size } }
                                    end

                                elseif element.Type == "Button" then
                                    local b_pos, b_size = element_pos, vector2(group_size.x - 16, 22)
                                    local hovered = is_mouse_in_rect(b_pos, b_size)
                                    draw_chamfered_filled(b_pos, b_size, 6, hovered and not mouse_down and lerp_color(Library.MainColor, accent, 0.22) or Library.MainColor)
                                    draw_chamfered_outline(b_pos, b_size, 6, hovered and accent or Library.OutlineColor, 1)
                                    if hovered then draw_corner_brackets(b_pos, b_size, accent, 6, 1, 2) end
                                    local text_to_render = element.Text
                                    if element.DoubleClick and element.LastClick ~= 0 and get_unixtime() - element.LastClick < 1 then text_to_render = "Confirm?" end
                                    local clip_text = get_clipped_text(text_to_render, b_size.x - 10)
                                    local ct_size = render.get_text_size(clip_text)
                                    render.add_text(b_pos:add(vector2(b_size.x/2 - ct_size.x/2, b_size.y/2 - ct_size.y/2)), clip_text, Library.FontColor)
                                    if not Library.DraggingWindow and mouse_pressed and hovered and can_interact then
                                        if element.DoubleClick then
                                            if element.LastClick ~= 0 and get_unixtime() - element.LastClick < 1 then
                                                if element.Func then element.Func() end
                                                element.LastClick = 0
                                            else
                                                element.LastClick = get_unixtime()
                                            end
                                        else
                                            if element.Func then element.Func() end
                                        end
                                    end

                                elseif element.Type == "Dropdown" then
                                    render.add_text(element_pos, element.Text, Library.FontColor)
                                    local d_pos, d_size = element_pos:add(vector2(0, 17)), vector2(group_size.x - 16, 22)
                                    element.Layout = { pos = d_pos, size = d_size }
                                    draw_chamfered_filled(d_pos, d_size, 6, Library.MainColor)
                                    draw_chamfered_outline(d_pos, d_size, 6, element.Open and accent or Library.OutlineColor, 1)
                                    if element.Open then draw_corner_brackets(d_pos, d_size, accent, 6, 1, 2) end
                                    local display_text
                                    if element.Multi then
                                        local selected = {}
                                        for k, v in pairs(element.Value) do if v then table.insert(selected, k) end end
                                        display_text = #selected > 0 and table.concat(selected, ", ") or "None"
                                    else
                                        display_text = tostring(element.Value)
                                    end
                                    render.add_text(d_pos:add(vector2(8, 4)), get_clipped_text(display_text, d_size.x - 26), Library.FontColor)
