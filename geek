I.tapRelease = { 0, 0, 0, 0 }
I.holdingActive = { false, false, false, false }

I.laneArmed = { true, true, true, true }
I.prevDist = { nil, nil, nil, nil }
I.holdStart = { 0, 0, 0, 0 }
I.holdMiss = { 0, 0, 0, 0 }
I.lastScanAt = nil
I.pendingAt = { nil, nil, nil, nil }
I.pendingHold = { false, false, false, false }
I.pendingTailH = { 0, 0, 0, 0 }
I.pendingD = { 0, 0, 0, 0 }
I.pendingSpeed = { 0, 0, 0, 0 }
I.pendingFrom = { 0, 0, 0, 0 }
I.laneHoldCount = { 0, 0, 0, 0 }
I.HOLD_GRACE_TICKS = 4
