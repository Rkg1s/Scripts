I.lastLaneRenderData = { {}, {}, {}, {} }

local function tryGet(fn)
    local ok, v = pcall(fn)
    if ok and v ~= nil then return v end
    return nil
end

local function read_gui_text(inst)
    if not valid(inst) then return nil end
    local s = rd_str(inst, Const.OFF.GuiText)
    if type(s) ~= "string" or s == "" then return nil end
    return s
end

local function key_from_text(s)
    if not s then return nil end
    local c = string.upper(string.sub(s, 1, 1))
    local b = string.byte(c)
    if not b then return nil end
    if b >= 65 and b <= 90 then return b end
    if b >= 48 and b <= 57 then return b end
    return nil
end

local function vk_name(vk)
    if not vk then return "?" end
    if vk >= 65 and vk <= 90 then return string.char(vk) end
    if vk >= 48 and vk <= 57 then return string.char(vk) end
    return string.format("0x%02X", vk)
end

local function release_all_instrument_keys()
    for i = 1, 4 do
        if I.currentKeys[i] then
            input.simulate_press_up(I.currentKeys[i])
        end
        I.tapping[i] = false
        I.holdingActive[i] = false
        I.laneArmed[i] = true
        I.prevDist[i] = nil
        I.holdMiss[i] = 0
        I.pendingAt[i] = nil
        I.lastLaneRenderData[i] = {}
    end
end

local function get_scale()
    local screen = get_screen_size()
    if screen and screen.y then return screen.y / 1080 end
    return 1
end

local function get_song_label()
    local lp = get_local_player()
    if not valid(lp) then return "?" end
    local pgui = tryGet(function() return lp:find_first_child("PlayerGui") end)
    if not valid(pgui) then return "?" end
    local rsUI = tryGet(function() return pgui:find_first_child("RhythmServiceUI") end)
    if not valid(rsUI) then return "?" end
    local root = tryGet(function() return rsUI:find_first_child("RhythmRoot") end)
    if not valid(root) then return "?" end
    local credits = tryGet(function() return root:find_first_child("SongCredits") end)
    if not valid(credits) then return "?" end

    local title = read_gui_text(tryGet(function() return credits:find_first_child("Title") end))
    local charter = read_gui_text(tryGet(function() return credits:find_first_child("Charter") end))
    if title and charter then return title .. " [" .. charter .. "]" end
    return title or "?"
end

local function setup_instrument_gui()
    local lp = get_local_player()
    if not valid(lp) then return false end

    local player_gui = tryGet(function() return lp:find_first_child("PlayerGui") end)
    if not valid(player_gui) then return false end

    local rsUI = tryGet(function() return player_gui:find_first_child("RhythmServiceUI") end)
    if not valid(rsUI) then return false end

    local root = tryGet(function() return rsUI:find_first_child("RhythmRoot") end)
    if not valid(root) then return false end

    local receptors = tryGet(function() return root:find_first_child("Receptors") end)
    local lanesHost = tryGet(function() return root:find_first_child("Lanes") end)
    if not valid(receptors) or not valid(lanesHost) then return false end

    local newReceptors = {}
    local newKeys = {}
    local validLanes = 0

    for i = 1, 8 do
        local rec = tryGet(function() return receptors:find_first_child("Receptor" .. i) end)
        if not valid(rec) then break end

        local pos = tryGet(function() return rec.gui_position end)
        local size = tryGet(function() return rec.gui_size end)
        if pos and size then
            newReceptors[i] = {
                cx = pos.x + (size.x / 2),
                hitY = pos.y,
            }

            local hint = tryGet(function() return rec:find_first_child("KeyHint") end)
            local hint_text = read_gui_text(hint)
            newKeys[i] = key_from_text(hint_text) or I.DEFAULT_KEYS[i]
            validLanes = validLanes + 1
        end
    end

    if validLanes == 0 then return false end

    I.activeLaneCount = validLanes
    I.currentKeys = newKeys
    I.uiReceptorData = newReceptors
    I.uiLanesContainer = lanesHost
    I.guiActive = true

    local key_list = {}
    for i = 1, I.activeLaneCount do
        key_list[i] = vk_name(I.currentKeys[i])
    end
    log.add(string.format("[instrument] %s -- %d lanes, keys: %s, hit line y=%.0f",
        get_song_label(), I.activeLaneCount, table.concat(key_list, " "),
        newReceptors[1] and newReceptors[1].hitY or 0), Colors.CYAN)

    return true
end

local function instrument_gui_gone()
    local lp = get_local_player()
    if not valid(lp) then return true end
    local player_gui = tryGet(function() return lp:find_first_child("PlayerGui") end)
    if not valid(player_gui) then return true end
    local rsUI = tryGet(function() return player_gui:find_first_child("RhythmServiceUI") end)
    return not valid(rsUI)
end

local function instrument_scan_frame(now)
    local rawNotes = tryGet(function() return I.uiLanesContainer:get_children() end)
    if not rawNotes then return end

    local dt = I.lastScanAt and (now - I.lastScanAt) or nil
    I.lastScanAt = now

    local laneCandidates = { {}, {}, {}, {} }
    local laneHoldSeen = { false, false, false, false }
    I.laneHoldCount = { 0, 0, 0, 0 }

    for _, note in pairs(rawNotes) do
        if tryGet(function() return note.class_name end) == "Frame"
            and tryGet(function() return note.name end) == "NoteTemplate" then

            if valid(note) then
                local pos = tryGet(function() return note.gui_position end)
                local size = tryGet(function() return note.gui_size end)
                if pos and size and pos.x > I.PARKED_COORD then
                    local cxNote = pos.x + (size.x / 2)
                    local cyNote = pos.y + (size.y / 2)

                    local bestLane, minDist = nil, math.huge
                    for i = 1, I.activeLaneCount do
                        if I.uiReceptorData[i] then
                            local d = math.abs(cxNote - I.uiReceptorData[i].cx)
                            if d < minDist then
                                minDist = d
                                bestLane = i
                            end
                        end
                    end

                    if bestLane and minDist <= I.LANE_MATCH_X then
                        local hitY = I.uiReceptorData[bestLane].hitY
                        local distY = cyNote - hitY

                        local tail = tryGet(function() return note:find_first_child("Tail") end)
                        local tailH = tail and tryGet(function() return tail.gui_size.y end) or 0
                        local tailPos = tail and tryGet(function() return tail.gui_position end) or nil
                        local isHold = tailH > I.HOLD_MIN_H

                        if isHold then
                            I.laneHoldCount[bestLane] = I.laneHoldCount[bestLane] + 1
                            if tailPos and (tailPos.y - hitY) <= 0
                                and ((tailPos.y + tailH) - hitY + 15) > I.TOUCH_DIST then
                                laneHoldSeen[bestLane] = true
                            end
                        end

                        if distY <= I.PAST_CATCH then
                            table.insert(laneCandidates[bestLane], {
                                headY = cyNote,
                                dist = distY,
                                isHold = isHold,
                                tailH = tailH,
                                holdReady = tailPos and (((tailPos.y + tailH) - hitY + 15) > I.TOUCH_DIST) or false,
                            })
                        end
                    end
                end
            end
        end
    end

    for lane = 1, I.activeLaneCount do
        local vk = I.currentKeys[lane]

        if I.tapping[lane] and now >= I.tapRelease[lane] then
            input.simulate_press_up(vk)
            I.tapping[lane] = false
        end

        if I.holdingActive[lane] then
            if laneHoldSeen[lane] then
                I.holdMiss[lane] = 0
            else
                I.holdMiss[lane] = (I.holdMiss[lane] or 0) + 1
                if I.holdMiss[lane] >= I.HOLD_GRACE_TICKS then
                    input.simulate_press_up(vk)
                    I.holdingActive[lane] = false
                end
            end
        end

        local candidates = laneCandidates[lane]
        table.sort(candidates, function(a, b) return a.headY > b.headY end)
        I.lastLaneRenderData[lane] = candidates

        local nearest = nil
        for j, e in ipairs(candidates) do
            if j > I.MAX_NOTES_PER_LANE then break end
            if e.dist <= I.PAST_CATCH then
                nearest = e
                break
            end
        end

        local d = nearest and nearest.dist or nil
        local pv = I.prevDist[lane]

        if not d or d < -I.REARM_DIST then
            I.laneArmed[lane] = true
            I.prevDist[lane] = d
        else
            I.prevDist[lane] = d
        end

        if d and I.laneArmed[lane] then
            local ready = nearest.isHold and nearest.holdReady or math.abs(d) < I.TOUCH_DIST
            if ready then
                I.laneArmed[lane] = false
                I.pendingAt[lane] = now
                I.pendingHold[lane] = nearest.isHold
                I.pendingTailH[lane] = nearest.tailH
                I.pendingD[lane] = d
                I.pendingSpeed[lane] = 0
                I.pendingFrom[lane] = now
            end
        end
    end
end

local function instrument_fire_pending(now)
    for lane = 1, I.activeLaneCount do
        local at = I.pendingAt[lane]
        if at and now >= at then
            local vk = I.currentKeys[lane]
            I.pendingAt[lane] = nil

            if I.tapping[lane] or I.holdingActive[lane] then
                input.simulate_press_up(vk)
                I.tapping[lane] = false
                I.holdingActive[lane] = false
            end
            input.simulate_press_down(vk)

            local off = (I.pendingD[lane] or 0) + ((I.pendingSpeed[lane] or 0) * (now - (I.pendingFrom[lane] or now)))
            I.hit_count = I.hit_count + 1
            I.dist_sum = I.dist_sum + math.abs(off)
            if math.abs(off) > I.worst_dist then I.worst_dist = math.abs(off) end

            if I.pendingHold[lane] then
                I.holdingActive[lane] = true
                I.holdStart[lane] = now
                I.holdMiss[lane] = 0
            else
                I.tapping[lane] = true
                I.tapRelease[lane] = now + I.TAP_HOLD_MS
            end
        end
    end
end

local function draw_instrument_notes()
    if not UI.instrument_on:get_value() then return end
    if not I.guiActive or not I.uiReceptorData then return end

    local scale = get_scale()
    for lane = 1, I.activeLaneCount do
        local cx = I.uiReceptorData[lane] and I.uiReceptorData[lane].cx
        if cx then
            for _, e in ipairs(I.lastLaneRenderData[lane]) do
                local onLine = e.dist >= -I.TOUCH_DIST and e.dist <= I.PAST_CATCH
                local col = onLine and I.COLOR_ON_LINE or (e.isHold and I.COLOR_HOLD or I.LANE_COLORS[lane])
                render.add_circle(vector2(cx, e.headY), 20 * scale, col)
                if e.isHold and e.tailH > 0 then
                    render.add_line(vector2(cx, e.headY), vector2(cx, e.headY - e.tailH), col, 4)
                end
            end
        end
    end
end

local function draw_instrument_esp()
    if not UI.instrument_on:get_value() then return end
    if not I.guiActive or not I.uiReceptorData then return end

    local scale = get_scale()
    local first = I.uiReceptorData[1]
    local last = I.uiReceptorData[I.activeLaneCount]
    if first and last then
        local lx = first.cx - (50 * scale)
        local rx = last.cx + (50 * scale)
        render.add_line(vector2(lx, first.hitY), vector2(rx, first.hitY), I.LINE_COLOR, 4 * scale)
    end
    draw_instrument_notes()
end

I.instrumentLastCheck = 0
I.lastScanRun = 0
I.SCAN_INTERVAL_MS = 8

local function instrument_tick(now)
    instrument_fire_pending(now)

    if now - I.instrumentLastCheck >= 500 then
        I.instrumentLastCheck = now
        if I.guiActive then
            if instrument_gui_gone() then
                if I.hit_count > 0 then
                    log.add(string.format("[instrument] song over -- %d notes, avg off %.1fpx, worst %.1fpx",
                        I.hit_count, I.dist_sum / I.hit_count, I.worst_dist), Colors.CYAN)
                end
                I.guiActive = false
                release_all_instrument_keys()
                return
            end
        else
            I.hit_count = 0
            I.dist_sum = 0
            I.worst_dist = 0
            setup_instrument_gui()
            return
        end
    end

    if not I.guiActive then return end

    if now - I.lastScanRun >= I.SCAN_INTERVAL_MS then
        I.lastScanRun = now
        instrument_scan_frame(now)
    end
end

