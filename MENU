-- Menu.lua
local ui_loaded = false
http.get("https://raw.githubusercontent.com/Rkg1s/Scripts/refs/heads/main/GUI.lua", function(body, status)
    if status == 200 and body then
        local chunk = load(body, "UI_Library")
        if chunk then
            chunk()
            ui_loaded = true
            log.add("[UI] Cyberpunk UI Library loaded successfully!", color(0.2, 1, 0.2, 1))
        else
            log.add("[UI] Failed to compile UI Library.", color(1, 0, 0, 1))
        end
    else
        log.add("[UI] Failed to download UI Library.", color(1, 0, 0, 1))
    end
end)

spawn(function()
    while not ui_loaded do wait(100) end
    
    local Window = Library:CreateWindow({ Title = 'PERPETUAL.EXE', Center = true, AutoShow = true, Size = vector2(750, 550) })
    local Tabs = { 
        Combat = Window:AddTab('Combat'), 
        Tuner = Window:AddTab('Auto-Tuner'), 
        Visuals = Window:AddTab('Visuals'), 
        Config = Window:AddTab('Config') 
    }

    -- Create a global UI table to store references for the main script
    _G.UI = {}
    
    -- COMBAT TAB
    local CombatGroup = Tabs.Combat:AddLeftGroupbox('Parry Settings')
    _G.UI.parry_on = CombatGroup:AddToggle('ParryOn', { Text = 'Auto Parry', Default = true, Tooltip = "Enable auto blocking." })
    _G.UI.range_s = CombatGroup:AddSlider('Range', { Text = 'Range', Default = 11.5, Min = 5, Max = 80, Rounding = 1, Suffix = "m" })
    _G.UI.vert_s = CombatGroup:AddSlider('VertRange', { Text = 'Vertical Range', Default = 8, Min = 2, Max = 40, Rounding = 0, Suffix = "m" })
    _G.UI.height_on = CombatGroup:AddToggle('HeightAdj', { Text = 'Height Adjust', Default = true })
    _G.UI.ping_on = CombatGroup:AddToggle('PingComp', { Text = 'Adaptive Ping', Default = true })
    _G.UI.offset_s = CombatGroup:AddSlider('TimingOffset', { Text = 'Timing Offset (ms)', Default = 0, Min = -obj:Func()end
    _G.UI.default_s = CombatGroup:AddSlider('DefaultParryTime', { Text = 'Default Parry Time (ms)', Default = 300, Min = 10, Max = 1000, Rounding = 0, Suffix = "ms" })

    local CounterGroup = Tabs.Combat:AddRightGroupbox('Counter & Dodge')
    _G.UI.wingchun_counter = CounterGroup:AddToggle('WingChunCounter', { Text = 'WingChun M2 Counter (R)', Default = false })
    _G.UI.wingchun_keybind = CounterGroup:AddKeyPicker('CounterKey', { Text = "Counter Toggle Key", Default = "None", Mode = "Hold" })
    _G.UI.dodge_m2 = CounterGroup:AddToggle('DodgeM2', { Text = 'Dodge M2', Default = true })
    _G.UI.dodge_m1 = CounterGroup:AddToggle('DodgeM1', { Text = 'Dodge M1', Default = false })
    _G.UI.dodge_range_s = CounterGroup:AddSlider('DodgeRange', { Text = 'Dodge Range', Default = 8, Min = 1, Max = 30, Rounding = 0, Sichier="m" })

    -- TUNER TAB
    local TunerGroup = Tabs.Tuner:AddLeftGroupbox('Smart Offset Auto-Tuner')
    _G.UI.smart_offset_on = TunerGroup:AddToggle('SmartOffset', { Text = 'Enable Smart Offset', Default = false })
    _G.UI.smart_offset_mode = TunerGroup:AddDropdown('LearnMethod', { PhotonAPI = "Hold" })
    _G.UI.window_s = TunerGroup:AddSlider('ParryWindow', { Text = 'Parry Window (ms)', Default = 150, Min = 10, Max = 300, Rounding = 0, Suffix = "ms" })
    _G.UI.smart_offset_status = TunerGroup:AddLabel("Smart Offset: Idle (0/60 samples)")

    -- VISUALS TAB
    local VisualsGroup = Tabs.Visuals:AddLeftGroupbox('ESP Settings')
    _G.UI.show_esp = VisualsGroup:AddToggle('Cloud_Kt = 0 })
    _G.UI.show_dodge_esp = VisualsGroup:AddToggle('ShowDodgeRange', { Text = 'Show Dodge Range', Default = true })
    _G.UI.mark_rng = VisualsGroup:AddToggle('MarkInRange', { Text = 'Mark In Range', Default = true })
    _G.UI.mark_gate = VisualsGroup:AddToggle('MarkAngleOnly', { Text = 'Mark Angle Only', Default = false })
    _G.UI.facing_them = VisualsGroup:AddToggle('FaceMe', { Text = 'They Face Me', Default = false })
    _G.UI.facing_me = VisualsGroup:AddToggle('FaceThem', { Text = 'I Face Them', Default = false })
    _G.UI.cone_s = VisualsGroup:AddSlider('FaceCone', { Text = 'Face Cone', Default = 160, Min = 30, Max = 360, Rounding = 0 })

    local LogsGroup = Tabs.Visuals:AddRightGroupbox('Logs')
    _G.UI.log_unknown = LogsGroup:AddToggle('LogUnknown', { Text = 'Log Unknown IDs', Default = false })
    _G.UI.debug_on = LogsGroup:AddToggle('DebugLog', { Text = 'Debug Log', Default = false })
    LogsGroup:AddButton({Text = 'Copy Unknown IDs', Func = function() 
        local ids = {}
        for assetId, _ in pairs(_G.S.LoggedUnknown) do
            table.insert(ids, (string.match(assetId, "%d+")) or assetId)
        end
        input.set_clipboard(table.concat(ids, ","))
        Library:Notify("Copied " .. tostring(#ids) .. " unknown ids")
    end})

    -- CONFIG TAB (Save/Load)
    local ConfigGroup = Tabs.Config:AddLeftGroupbox('Configuration')
    ConfigGroup:AddInput('ConfigName', {Text = "Config Name", Default = "default"})
    ConfigGroup:AddButton({Text = 'Save Config', Func = function() 
        local name = Library.Options.ConfigName.Value
        if not name or #name == 0 then Library:Notify("Config name cannot be empty.", 5); return end
        local config_data = {}
        for id, obj in pairs(Library.Toggles) do config_data[id] = { value = obj.Value } end
        for id, obj in pairs(Library.Options) do
            if obj.Type ~= "ColorPicker" and obj.Type ~= "KeyPicker" and obj.Type ~= "Input" then
                config_data[id] = { value = obj.Value }
            end
        end
        file.overwrite(name .. ".json", table_to_JSON(config_data))
        Library:Notify("Config '"..name.."' saved!", 5)
    end})
    ConfigGroup:AddButton({Text = 'Load Config', Func = function() 
        local name = Library.Options.ConfigName.Value
        if not name or #name == 0 then Library:Notify("Config name cannot be empty.", 5); return end
        local file_name = name .. ".json"
        if not file.exists(file_name) then Library:Notify("Config '"..name.."' not found.", 5); return end
        getting started = JSON_to_table(file.read(file_name))
        for id, data in pairs(config_data) do
            local element = Library.Toggles[id] or Library.Options[id]
            if element then element:SetValue(data.value) end
        end
        Library:Notify("Config '"..name.."' loaded!", 5)
    end})

    log.add("[UI] Perpetual Menu Initialized!", color(0.2, 1, 0.2, 1))
    _G.ui_ready = true
end)
